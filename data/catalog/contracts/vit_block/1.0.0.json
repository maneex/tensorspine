{
  "schema": "armature-catalog-unit/2.0",
  "kind": "contract",
  "name": "vit_block",
  "definition": {
    "version": "1.0.0",
    "summary": "Vision-transformer block projections: fused QKV, attention output, FFN up and down.",
    "description": "The learned tensors of one bidirectional vision block: `qkv`, whose fused axis is an exact product `projection × head × channel` and therefore declares its factors; `out`; and a dense FFN `in` / `ffn_out`. A vision tower processes an image in one pass without causality, so the block carries no state.",
    "tags": [
      "multimodal"
    ],
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2010.11929",
        "title": "An Image is Worth 16x16 Words (Dosovitskiy et al., 2020)",
        "kind": "paper"
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the vision tower."
      },
      "heads": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Attention heads."
      },
      "head_dim": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Dimension of one head."
      },
      "inner": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Inner width of the FFN."
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Patch activations."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Block output."
        }
      }
    },
    "parameters": {
      "qkv": {
        "role": "attention.qkv_projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "qkv_flat",
              "axis": "attention.qkv_flat",
              "nature": "projection",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "literal": 3
                  },
                  {
                    "argument": "heads"
                  },
                  {
                    "argument": "head_dim"
                  }
                ]
              },
              "factors": [
                {
                  "name": "projection",
                  "axis": "ffn.projection",
                  "nature": "projection",
                  "extent": {
                    "literal": 3
                  }
                },
                {
                  "name": "head",
                  "axis": "attention.heads",
                  "nature": "structural",
                  "extent": {
                    "argument": "heads"
                  }
                },
                {
                  "name": "channel",
                  "axis": "attention.head_dim",
                  "nature": "feature",
                  "extent": {
                    "argument": "head_dim"
                  }
                }
              ]
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "note": "without GQA the fused axis IS an exact product: the projection x head x channel decomposition is declarable",
        "description": "Fused query, key and value projection: `3 × heads × head_dim` rows."
      },
      "out": {
        "role": "attention.output_projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "heads_flat",
              "axis": "attention.heads",
              "nature": "projection",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "heads"
                  },
                  {
                    "argument": "head_dim"
                  }
                ]
              }
            }
          ]
        },
        "description": "Attention output projection."
      },
      "in": {
        "role": "ffn.up_projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "inner",
              "axis": "ffn.inner",
              "nature": "feature",
              "extent": {
                "argument": "inner"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "FFN up projection."
      },
      "ffn_out": {
        "role": "ffn.down_projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "inner",
              "axis": "ffn.inner",
              "nature": "feature",
              "extent": {
                "argument": "inner"
              }
            }
          ]
        },
        "description": "FFN down projection."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "attention.heads"
        },
        "semantics": "preserved",
        "communication": "all_reduce",
        "description": "Tensor parallelism across heads."
      },
      {
        "target": {
          "argument_axis": "ffn.inner"
        },
        "semantics": "preserved",
        "communication": "all_reduce",
        "description": "Tensor parallelism across the FFN inner width."
      }
    ],
    "note": "no state: a vision tower processes an image in one pass, without causality"
  }
}
