    "    map values  keys #/$defs/qualified_name",
    "    map parameters  keys #/$defs/qualified_name",
    "    map constants  keys #/$defs/qualified_name",
    "    map states  keys #/$defs/qualified_name",
  ],
  "composition_map": [
    "map composition_map  keys #/$defs/identifier",
  ],
  "condition": [
    "condition condition  {boolean:toggle | condition:condition}",
  ],
  "conditional_expression": [
    "section conditional_expression",
