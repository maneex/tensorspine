{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "conv_frontend",
  "definition": {
    "version": "1.0.0",
    "summary": "Audio front end: two temporal convolutions over mel frames, the second strided, plus optional learned positions.",
    "description": "`frames` carries `mels` features per frame; `conv1_weight` maps them to `width` with a kernel of `kernel` frames, and `conv2_weight` applies a second convolution with stride `stride`, which sets the ratio between input frames and output positions. `position` adds a learned position table when the encoder does not use rotary positions. Output positions are in the `position` domain of the audio stream. The padding is symmetric (`kernel − 1` over two, each side, as the Whisper stem) unless `causal`, when it is on the left alone (`kernel − stride` frames, as Voxtral Realtime's); a causal front end on a fragmented stream declares `streaming` and keeps, per convolution, the frames its next output needs from the previous fragment — `conv1_history`, `kernel − 1` input frames, and `conv2_history`, `kernel − stride` frames of the first convolution's output — so that the fragments compute what the whole signal would (§5.3). The output of each convolution is followed by an activation the witness fixes.",
    "tags": [
      "multimodal"
    ],
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2212.04356",
        "title": "Robust Speech Recognition via Large-Scale Weak Supervision (Radford et al., 2022)",
        "kind": "paper",
        "description": "The Whisper encoder stem: two convolutions, the second with stride two."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the encoder."
      },
      "mels": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Mel bins per frame."
      },
      "stride": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Stride of the second convolution: input frames per output position."
      },
      "kernel": {
        "type": {
          "kind": "cardinality"
        },
        "required": false,
        "structural": true,
        "default": {
          "literal": 3
        },
        "description": "Kernel support of both convolutions, in frames."
      },
      "bias": {
        "type": {
          "kind": "boolean"
        },
        "required": false,
        "structural": true,
        "default": {
          "literal": true
        },
        "description": "The convolutions carry a learned bias."
      },
      "position": {
        "type": {
          "kind": "cardinality"
        },
        "required": false,
        "structural": true,
        "note": "number of learned positions; absent for RoPE",
        "description": "Number of learned positions; absent when positions are rotary."
      },
      "causal": {
        "type": {
          "kind": "boolean"
        },
        "required": false,
        "structural": true,
        "default": {
          "literal": false
        },
        "description": "Left-only padding of both convolutions, `kernel − stride` frames before the first: each output reads its own frames and earlier ones only (Voxtral Realtime). Absent or false, the padding is symmetric (Whisper)."
      },
      "streaming": {
        "type": {
          "kind": "boolean"
        },
        "required": false,
        "structural": true,
        "present_when": {
          "compare": {
            "operator": "equal",
            "left": {
              "argument": "causal"
            },
            "right": {
              "literal": true
            }
          }
        },
        "description": "The front end reads a fragmented stream and keeps, per convolution, the history its next output needs from the previous fragment (V18, §5.3). Applicable to a causal front end only: a symmetric window would need frames that have not arrived."
      }
    },
    "ports": {
      "inputs": {
        "frames": {
          "shape": {
            "axes": [
              {
                "name": "mels",
                "axis": "audio.mels",
                "nature": "feature",
                "extent": {
                  "argument": "mels"
                }
              }
            ]
          },
          "domain": {
            "kind": "position",
            "from": {
              "self": true
            }
          },
          "role": "activation.audio_frames",
          "description": "Mel-spectrogram frames."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "position",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Encoder input: one vector per output position."
        }
      }
    },
    "parameters": {
      "conv1_weight": {
        "role": "frontend.convolution",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "mels",
              "axis": "audio.mels",
              "nature": "feature",
              "extent": {
                "argument": "mels"
              }
            },
            {
              "name": "kernel",
              "axis": "sequence.kernel",
              "nature": "structural",
              "extent": {
                "argument": "kernel"
              }
            }
          ]
        },
        "description": "First convolution, `mels → width`."
      },
      "conv1_bias": {
        "role": "frontend.bias",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "present_when": {
          "compare": {
            "operator": "equal",
            "left": {
              "argument": "bias"
            },
            "right": {
              "literal": true
            }
          }
        },
        "description": "Bias of the first convolution."
      },
      "conv2_weight": {
        "role": "frontend.convolution",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "kernel",
              "axis": "sequence.kernel",
              "nature": "structural",
              "extent": {
                "argument": "kernel"
              }
            }
          ]
        },
        "description": "Second convolution, `width → width`, strided."
      },
      "conv2_bias": {
        "role": "frontend.bias",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "present_when": {
          "compare": {
            "operator": "equal",
            "left": {
              "argument": "bias"
            },
            "right": {
              "literal": true
            }
          }
        },
        "description": "Bias of the second convolution."
      },
      "position": {
        "role": "embedding.position",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "position",
              "axis": "sequence.position",
              "nature": "structural",
              "extent": {
                "argument": "position"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "present_when": {
          "present": "position"
        },
        "description": "Learned position table."
      }
    },
    "constants": {},
    "state_ports": {
      "conv1_history": {
        "present_when": {
          "all": [
            {
              "present": "streaming"
            },
            {
              "compare": {
                "operator": "equal",
                "left": {
                  "argument": "streaming"
                },
                "right": {
                  "literal": true
                }
              }
            },
            {
              "compare": {
                "operator": "greater",
                "left": {
                  "argument": "kernel"
                },
                "right": {
                  "literal": 1
                }
              }
            }
          ]
        },
        "payload": {
          "w": {
            "shape": {
              "axes": [
                {
                  "name": "mels",
                  "axis": "audio.mels",
                  "nature": "feature",
                  "extent": {
                    "argument": "mels"
                  }
                }
              ]
            },
            "role": "state.conv",
            "description": "One input frame: `mels` features."
          }
        },
        "key_axes": [
          "instance.session",
          "instance.branch"
        ],
        "carried_across": {
          "when": {
            "all": [
              {
                "present": "streaming"
              },
              {
                "compare": {
                  "operator": "equal",
                  "left": {
                    "argument": "streaming"
                  },
                  "right": {
                    "literal": true
                  }
                }
              }
            ]
          },
          "description": "With `streaming`, the ring survives between the invocations that deliver successive fragments of the frames' stream: the next fragment's first outputs read it."
        },
        "operations": {
          "append": {
            "effect": "append",
            "description": "Push the frames of this invocation."
          },
          "read": {
            "effect": "read",
            "description": "Read the history the first outputs of a fragment need."
          }
        },
        "rules": [
          {
            "when": {
              "boolean": true
            },
            "law": "window",
            "access": "ring",
            "sharing": "within_span",
            "indexed_by": {
              "port": "frames"
            },
            "span": {
              "op": "subtract",
              "args": [
                {
                  "argument": "kernel"
                },
                {
                  "literal": 1
                }
              ]
            },
            "description": "A ring of the last frames of the `frames` stream, indexed by that stream: grown across its fragments, frozen when it is complete."
          }
        ],
        "description": "Input history of the first convolution (stride one): the `kernel − 1` frames before the fragment, so that its first outputs read the frames the whole signal would give them."
      },
      "conv2_history": {
        "present_when": {
          "all": [
            {
              "present": "streaming"
            },
            {
              "compare": {
                "operator": "equal",
                "left": {
                  "argument": "streaming"
                },
                "right": {
                  "literal": true
                }
              }
            },
            {
              "compare": {
                "operator": "greater",
                "left": {
                  "argument": "kernel"
                },
                "right": {
                  "argument": "stride"
                }
              }
            }
          ]
        },
        "payload": {
          "w": {
            "shape": {
              "axes": [
                {
                  "name": "feature",
                  "axis": "model.width",
                  "nature": "feature",
                  "extent": {
                    "argument": "width"
                  }
                }
              ]
            },
            "role": "state.conv",
            "description": "One frame of the first convolution's output: `width` channels."
          }
        },
        "key_axes": [
          "instance.session",
          "instance.branch"
        ],
        "carried_across": {
          "when": {
            "all": [
              {
                "present": "streaming"
              },
              {
                "compare": {
                  "operator": "equal",
                  "left": {
                    "argument": "streaming"
                  },
                  "right": {
                    "literal": true
                  }
                }
              }
            ]
          },
          "description": "With `streaming`, the ring survives between the invocations that deliver successive fragments of the frames' stream: the next fragment's first outputs read it."
        },
        "operations": {
          "append": {
            "effect": "append",
            "description": "Push the frames of this invocation."
          },
          "read": {
            "effect": "read",
            "description": "Read the history the first outputs of a fragment need."
          }
        },
        "rules": [
          {
            "when": {
              "boolean": true
            },
            "law": "window",
            "access": "ring",
            "sharing": "within_span",
            "indexed_by": {
              "port": "frames"
            },
            "span": {
              "op": "subtract",
              "args": [
                {
                  "argument": "kernel"
                },
                {
                  "argument": "stride"
                }
              ]
            },
            "description": "A ring of the last frames of the `frames` stream, indexed by that stream: grown across its fragments, frozen when it is complete."
          }
        ],
        "description": "History of the second, strided convolution: the `kernel − stride` frames of the first convolution's output before the fragment — and no more, or the stride's phase would shift by a frame at the boundary."
      }
    },
    "effects": {
      "reads": [
        "frames"
      ],
      "writes": [
        "output"
      ],
      "across_positions": {
        "when": {
          "compare": {
            "operator": "greater",
            "left": {
              "argument": "kernel"
            },
            "right": {
              "literal": 1
            }
          }
        },
        "description": "each output reads `kernel` frames, across the boundary of the `stride` frames that are its own; a kernel of one reads nothing but its own frame"
      }
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "model.width"
        },
        "communication": "none",
        "description": "Output channels are independent: each shard computes its channels."
      }
    ],
    "domain_transforms": [
      {
        "from_port": "frames",
        "to_port": "output",
        "relation": "merge",
        "factor": {
          "argument": "stride"
        },
        "description": "The second convolution is strided: one output position per `stride` input frames, in the same stream. On a fragmented stream, every fragment delivers a multiple of `stride` frames (§5.3: the fragment alignment the merge implies)."
      }
    ],
    "sparsity": [
      {
        "unit": {
          "parameters": [
            "position"
          ],
          "axis": "sequence.position"
        },
        "policy": {
          "element": true
        },
        "activated_per_element": {
          "literal": 1
        },
        "union_per_invocation": {
          "expression": {
            "argument": "position"
          },
          "status": "upper_bound",
          "per": "invocation",
          "description": "An invocation may touch every row; the worst-case union is the whole table."
        },
        "description": "A lookup: each frame activates the row of its own position."
      }
    ]
  }
}
