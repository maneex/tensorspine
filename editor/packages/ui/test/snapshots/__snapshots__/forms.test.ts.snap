    "    text reason  required  length>=1 matches \\S",
    "    text superseded_by  matches ^[A-Za-z_][A-Za-z0-9_-]*$",
  ],
  "base_documentation": [
    "section base_documentation",
    "  text title  length>=1 length<=120 matches ^[^\\r\\n]*\\S$",
    "  text summary  length>=1 length<=120 matches ^[^\\r\\n]*\\S$",
    "  text description  length>=1 matches \\S",
    "  section contact  members>=1",
    "    text name  length>=1",
    "    text url  length>=1 matches ^\\S+$",
    "    text email  length>=3 matches ^[^@\\s]+@[^@\\s]+$",
    "  section license",
    "    text name  required  length>=1",
    "    text identifier  length>=1",
    "    text url  length>=1 matches ^\\S+$",
    "  list external_docs  items>=1",
    "  list tags  items>=1",
  ],
