{
  "schema": "armature-catalog-unit/2.0",
  "kind": "contract",
  "name": "conv_frontend",
  "definition": {
    "version": "2.0.0",
    "summary": "Audio front end: two temporal convolutions over mel frames, the second strided, plus optional learned positions.",
    "description": "`frames` carries `mels` features per frame; `conv1_weight` maps them to `width` with a kernel of `kernel` frames, and `conv2_weight` applies a second convolution with stride `stride`, which sets the ratio between input frames and output positions. `position` adds a learned position table when the encoder does not use rotary positions. Output positions are in the `position` domain of the audio stream.",
    "tags": [
      "multimodal"
    ],
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2212.04356",
        "title": "Robust Speech Recognition via Large-Scale Weak Supervision (Radford et al., 2022)",
        "kind": "paper",
        "description": "The Whisper encoder stem: two convolutions, the second with stride two."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Feature width of the encoder."
      },
      "mels": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Mel bins per frame."
      },
      "stride": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Stride of the second convolution: input frames per output position."
      },
      "kernel": {
        "type": {
          "kind": "cardinality"
        },
        "required": false,
        "affects_template": true,
        "default": {
          "literal": 3
        },
        "description": "Kernel support of both convolutions, in frames."
      },
      "bias": {
        "type": {
          "kind": "boolean"
        },
        "required": false,
        "affects_template": true,
        "default": {
          "literal": true
        },
        "description": "The convolutions carry a learned bias."
      },
      "position": {
        "type": {
          "kind": "cardinality"
        },
        "required": false,
        "affects_template": true,
        "note": "number of learned positions; absent for RoPE",
        "description": "Number of learned positions; absent when positions are rotary."
      }
    },
    "ports": {
      "inputs": {
        "frames": {
          "shape": {
            "axes": [
              {
                "name": "mels",
                "axis": "audio.mels",
                "nature": "feature",
                "extent": {
                  "argument": "mels"
                }
              }
            ]
          },
          "domain": {
            "kind": "position",
            "from": {
              "self": true
            }
          },
          "role": "activation.audio_frames",
          "description": "Mel-spectrogram frames."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "position",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Encoder input: one vector per output position."
        }
      }
    },
    "parameters": {
      "conv1_weight": {
        "role": "frontend.convolution",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "mels",
              "axis": "audio.mels",
              "nature": "feature",
              "extent": {
                "argument": "mels"
              }
            },
            {
              "name": "kernel",
              "axis": "audio.kernel",
              "nature": "structural",
              "extent": {
                "argument": "kernel"
              }
            }
          ]
        },
        "description": "First convolution, `mels → width`."
      },
      "conv1_bias": {
        "role": "frontend.bias",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "present_when": {
          "compare": {
            "operator": "equal",
            "left": {
              "argument": "bias"
            },
            "right": {
              "literal": true
            }
          }
        },
        "description": "Bias of the first convolution."
      },
      "conv2_weight": {
        "role": "frontend.convolution",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "kernel",
              "axis": "audio.kernel",
              "nature": "structural",
              "extent": {
                "argument": "kernel"
              }
            }
          ]
        },
        "description": "Second convolution, `width → width`, strided."
      },
      "conv2_bias": {
        "role": "frontend.bias",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "present_when": {
          "compare": {
            "operator": "equal",
            "left": {
              "argument": "bias"
            },
            "right": {
              "literal": true
            }
          }
        },
        "description": "Bias of the second convolution."
      },
      "position": {
        "role": "embedding.position",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "position",
              "axis": "sequence.position",
              "nature": "structural",
              "extent": {
                "argument": "position"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "present_when": {
          "present": "position"
        },
        "description": "Learned position table."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "frames"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": []
  }
}
