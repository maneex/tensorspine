{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "residual.laurel",
  "definition": {
    "version": "1.0.0",
    "summary": "LAuReL branch: a low-rank projection of the input, normalized, to be added to the residual.",
    "description": "`left` projects `width` to `rank`, `right` projects back to `width`, and `norm` (RMS, `eps`) normalizes the result: a learned, low-rank augmentation of the residual connection.",
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2411.07501",
        "title": "LAuReL: Learned Augmented Residual Layer (Menghani et al., 2024)",
        "kind": "paper"
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of `input` and `output`."
      },
      "rank": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Rank of the low-rank pair."
      },
      "eps": {
        "type": {
          "kind": "real"
        },
        "required": true,
        "structural": false,
        "description": "Epsilon of the normalization; changes no tensor."
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Residual-stream activation."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The branch to add to the residual."
        }
      }
    },
    "parameters": {
      "left": {
        "role": "residual.low_rank",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "rank",
              "axis": "residual.rank",
              "nature": "feature",
              "extent": {
                "argument": "rank"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Down projection, `width → rank`."
      },
      "right": {
        "role": "residual.low_rank",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "rank",
              "axis": "residual.rank",
              "nature": "feature",
              "extent": {
                "argument": "rank"
              }
            }
          ]
        },
        "description": "Up projection, `rank → width`."
      },
      "norm": {
        "role": "norm.scale",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Scale of the output normalization."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "residual.rank"
        },
        "communication": "all_reduce",
        "description": "The low-rank bottleneck is split; the up projection's partial outputs are reduced."
      }
    ],
    "note": "Low-rank LAuReL residual branch followed by an RMSNorm."
  }
}
