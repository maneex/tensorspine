{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "projector.temporal_stack",
  "definition": {
    "version": "1.0.0",
    "summary": "Audio-language projector: `merge_count` stacked frames, a projection, an activation, a second projection, bias-free.",
    "description": "`merge_count` consecutive encoder outputs — the earliest first — are concatenated into one `source_width · merge_count` vector, projected to `width` by `input`, passed through `activation`, and projected again by `output`, `width → width`; neither projection carries a bias. The output is in the token domain: one token per stacked group. `activation` defaults to `gelu`, the activation every known delivery implementation of such a projector defaults to (transformers' Voxtral, Voxtral Realtime and AudioFlamingo 3 expose it as `projector_hidden_act`); a document states its value all the same, as it states `merge_count`.",
    "tags": [
      "multimodal"
    ],
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2507.13264",
        "title": "Voxtral (Mistral AI, 2025)",
        "kind": "paper",
        "description": "The audio-language adapter: frames downsampled by concatenation, then an MLP."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the language model."
      },
      "source_width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the audio encoder."
      },
      "merge_count": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Frames stacked into one token."
      },
      "activation": {
        "type": {
          "kind": "enum",
          "values": [
            "gelu",
            "gelu_tanh",
            "relu",
            "silu"
          ]
        },
        "required": false,
        "structural": false,
        "default": {
          "literal": "gelu"
        },
        "description": "Non-linearity between the two projections; changes no tensor. Defaults to `gelu`, the value every known delivery implementation defaults to.",
        "value_descriptions": {
          "gelu": "Exact GELU (Voxtral, Voxtral Realtime, AudioFlamingo 3).",
          "gelu_tanh": "Tanh-approximated GELU.",
          "relu": "ReLU (LLaMA-Omni's five-frame stack).",
          "silu": "SiLU."
        }
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "source_width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Encoder outputs, in the audio width."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "token",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "One token per stacked group."
        }
      }
    },
    "parameters": {
      "input": {
        "role": "projector.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "packed_audio",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "source_width"
                  },
                  {
                    "argument": "merge_count"
                  }
                ]
              }
            }
          ]
        },
        "description": "Projection from the stacked frames to `width`."
      },
      "output": {
        "role": "projector.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Second projection, `width → width`."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "model.width"
        },
        "communication": "all_gather",
        "description": "Column-parallel over the output features."
      }
    ],
    "domain_transforms": [
      {
        "from_port": "input",
        "to_port": "output",
        "relation": "merge",
        "factor": {
          "argument": "merge_count"
        },
        "description": "`merge_count` frames become one token."
      }
    ],
    "note": "Temporal stacking, earliest frame first, then projection, activation, projection — no biases."
  }
}
