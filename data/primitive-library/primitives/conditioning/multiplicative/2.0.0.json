{
  "schema": "tensorspine-primitive-library-unit/3.0",
  "kind": "primitive",
  "name": "conditioning.multiplicative",
  "definition": {
    "version": "2.0.0",
    "summary": "Per-layer conditioning: gates the input, multiplies by the condition, projects back and normalizes.",
    "description": "The input is projected by `gate` to `condition_width`, passed through `activation`, and multiplied element-wise with `condition`; `projection` brings the product back to `width`, and `norm` normalizes it (RMS, `eps`). The result is what the layer adds to its residual.",
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of `input` and `output`.",
        "domain": {
          "kind": "interval",
          "lower": {
            "value": {
              "literal": 1
            },
            "inclusive": true
          }
        }
      },
      "condition_width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Width of the conditioning vector.",
        "domain": {
          "kind": "interval",
          "lower": {
            "value": {
              "literal": 1
            },
            "inclusive": true
          }
        }
      },
      "eps": {
        "type": {
          "kind": "real"
        },
        "required": true,
        "structural": false,
        "description": "Epsilon of the normalization; changes no tensor.",
        "domain": {
          "kind": "interval",
          "lower": {
            "value": {
              "literal": 0
            },
            "inclusive": false
          }
        }
      },
      "activation": {
        "type": {
          "kind": "enum",
          "values": [
            "silu",
            "gelu",
            "gelu_tanh",
            "relu2"
          ]
        },
        "required": true,
        "structural": false,
        "description": "Applied to the gate projection before the product with `condition` (Gemma 3n: `gelu_tanh`)."
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Hidden state of the layer."
        },
        "condition": {
          "shape": {
            "axes": [
              {
                "name": "condition",
                "axis": "conditioning.feature",
                "nature": "feature",
                "extent": {
                  "argument": "condition_width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The layer's conditioning vector."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The conditioned contribution."
        }
      }
    },
    "parameters": {
      "gate": {
        "role": "conditioning.feature",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "per_layer",
              "axis": "conditioning.feature",
              "nature": "feature",
              "extent": {
                "argument": "condition_width"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Gate projection from `width` to `condition_width`."
      },
      "projection": {
        "role": "conditioning.feature",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "per_layer",
              "axis": "conditioning.feature",
              "nature": "feature",
              "extent": {
                "argument": "condition_width"
              }
            }
          ]
        },
        "description": "Projection from `condition_width` back to `width`."
      },
      "norm": {
        "role": "norm.scale",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Scale of the output normalization."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input",
        "condition"
      ],
      "writes": [
        "output"
      ]
    },
    "partition_options": [
      {
        "target": {
          "any_axis": true
        },
        "communication": "none",
        "description": "Elementwise per feature: any axis, no communication."
      }
    ],
    "note": "Per-condition multiplicative gate, reprojection to the model width and RMSNorm."
  }
}
