    "  select kind  required  [exclusive|shareable]",
    "  list roles  required-when #/$defs/sharing_rule/allOf/0/if  items>=1",
    "  text note",
  ],
  "sparsity": [
    "list sparsity  items>=1",
  ],
  "sparsity_unit": [
    "section sparsity_unit",
    "  section unit  required",
    "    list parameters  required  items>=1",
    "    text axis  required  matches ^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
    "  chooser policy  required  {argument:text | port:text | element:constant}",
    "  expression activated_per_element  required  {literal:scalar | argument:text→argument | expression:expression}",
    "  section union_per_invocation  required",
    "    expression expression  required  {literal:scalar | argument:text→argument | expression:expression}",
    "    select status  required  [exact|upper_bound|lower_bound|estimate]  shown as status",
    "    constant per  required  = invocation",
    "    text description  length>=1 matches \\S",
    "    text note",
    "  text description  length>=1 matches \\S",
    "  text note",
  ],
  "state_component": [
    "section state_component",
    "  axis-rows shape  required",
    "  text role  required  matches ^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
    "  text description  length>=1 matches \\S",
    "  text note",
  ],
  "state_operation": [
    "section state_operation",
    "  select effect  required  [read|append|evict|write]",
    "  text description  length>=1 matches \\S",
    "  text note",
  ],
  "state_port": [
    "section state_port",
    "  condition present_when  required  {boolean:toggle | condition:condition | present:text→present}",
    "  condition written_when  {boolean:toggle | condition:condition | present:text→present}",
    "  map payload  required  keys #/$defs/identifier  members>=1",
    "  list key_axes  required  items>=1",
    "  map operations  required  keys #/$defs/identifier",
    "  ordered-list rules  required  items>=1",
    "  text description  length>=1 matches \\S",
    "  text note",
    "  section carried_across",
    "    condition when  required  {boolean:toggle | condition:condition | present:text→present}",
    "    text description  length>=1 matches \\S",
    "    text note",
  ],
  "template_primitive": [
    "section template_primitive",
    "  text version  required  matches ^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
    "  list tags  items>=1 unique",
    "  list external_docs  items>=1",
    "  text summary  length>=1 length<=120 matches ^[^\\r\\n]*\\S$",
    "  text description  length>=1 matches \\S",
    "  text note",
    "  section template  required",
    "    text name  required  matches ^[A-Za-z_][A-Za-z0-9_-]*$",
    "    text version  required  matches ^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
    "    text id  required  matches ^[A-Za-z_][A-Za-z0-9_-]*$",
    "    text note",
    "  section deprecated",
    "    text reason  required  length>=1 matches \\S",
    "    section superseded_by",
    "      text name  required  matches ^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
    "      text version  required  matches ^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
  ],
  "unary_operation": [
    "section unary_operation",
    "  select op  required  [negate|absolute]",
    "  list args  required  items>=1 items<=1",
  ],
}
`;

