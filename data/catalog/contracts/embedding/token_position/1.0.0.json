{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "embedding.token_position",
  "definition": {
    "version": "1.0.0",
    "summary": "Token embedding plus a learned position table.",
    "description": "The embedded token is summed with a learned vector for its position, one of `positions`. `weight` is shareable with an output head, as in `embed`.",
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2212.04356",
        "title": "Robust Speech Recognition via Large-Scale Weak Supervision (Radford et al., 2022)",
        "kind": "paper",
        "description": "The Whisper decoder's learned position embedding."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the embedding."
      },
      "vocabulary": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Number of token identifiers."
      },
      "positions": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Number of positions the table covers: the maximum sequence length."
      }
    },
    "ports": {
      "inputs": {
        "tokens": {
          "shape": {
            "axes": []
          },
          "domain": {
            "kind": "token",
            "from": {
              "self": true
            }
          },
          "note": "token identifier: rank-zero scalar",
          "role": "activation.token_index",
          "description": "Token identifier: a rank-zero integer per token."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "token",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The embedded token."
        }
      }
    },
    "parameters": {
      "weight": {
        "role": "embedding.table",
        "sharing": {
          "kind": "shareable",
          "roles": [
            "embedding.table"
          ],
          "note": "sharing allowed between embedding table and output head: same axis identities in the same order, no view required"
        },
        "shape": {
          "axes": [
            {
              "name": "vocabulary",
              "axis": "model.vocabulary",
              "nature": "structural",
              "extent": {
                "argument": "vocabulary"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Token table."
      },
      "position": {
        "role": "embedding.position",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "position",
              "axis": "sequence.position",
              "nature": "structural",
              "extent": {
                "argument": "positions"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Position table, `positions × width`."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "tokens"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "model.vocabulary"
        },
        "semantics": "preserved",
        "communication": "all_gather",
        "description": "Vocabulary parallelism: each shard holds a slice of the token table; the looked-up rows are gathered."
      }
    ],
    "note": "Sum of a token table and a learned position table."
  }
}
