{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "lm_head",
  "definition": {
    "version": "1.0.0",
    "summary": "Output head: projects the hidden state to one logit per vocabulary entry.",
    "description": "`weight` has the same role and the same axes in the same order as `embed.weight`, so the two may share one tensor without a view (weight tying).",
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/1608.05859",
        "title": "Using the Output Embedding to Improve Language Models (Press & Wolf, 2017)",
        "kind": "paper",
        "description": "Tying the embedding table and the output head."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the hidden state."
      },
      "vocabulary": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Number of vocabulary entries."
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "token",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Final hidden state."
        }
      },
      "outputs": {
        "logits": {
          "shape": {
            "axes": [
              {
                "name": "vocabulary",
                "axis": "model.vocabulary",
                "nature": "structural",
                "extent": {
                  "argument": "vocabulary"
                }
              }
            ]
          },
          "domain": {
            "kind": "token",
            "from": {
              "self": true
            }
          },
          "role": "activation.logits",
          "description": "One logit per vocabulary entry."
        }
      }
    },
    "parameters": {
      "weight": {
        "role": "embedding.table",
        "sharing": {
          "kind": "shareable",
          "roles": [
            "embedding.table"
          ],
          "note": "sharing allowed between embedding table and output head: same axis identities in the same order, no view required"
        },
        "shape": {
          "axes": [
            {
              "name": "vocabulary",
              "axis": "model.vocabulary",
              "nature": "structural",
              "extent": {
                "argument": "vocabulary"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "note": "same role, same axis identities IN THE SAME ORDER as embed.weight: sharing is direct, with no view",
        "description": "The output projection, `vocabulary × width`."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "logits"
      ]
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "model.vocabulary"
        },
        "communication": "all_gather",
        "description": "Vocabulary parallelism: each shard computes a slice of the logits; the slices are gathered."
      }
    ]
  }
}
