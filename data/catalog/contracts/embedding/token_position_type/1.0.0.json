{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "embedding.token_position_type",
  "definition": {
    "version": "1.0.0",
    "summary": "BERT-style embedding: token, position and segment-type tables summed, then a LayerNorm.",
    "description": "Three lookups are summed — the token in `weight`, its position in `position`, its segment type in `token_type` — and the sum is normalized by a LayerNorm with scale and bias.",
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/1810.04805",
        "title": "BERT (Devlin et al., 2018)",
        "kind": "paper",
        "description": "Token, position and segment embeddings."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the embedding."
      },
      "vocabulary": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Number of token identifiers."
      },
      "positions": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Number of positions the table covers."
      },
      "token_types": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Number of segment types."
      }
    },
    "ports": {
      "inputs": {
        "tokens": {
          "shape": {
            "axes": []
          },
          "domain": {
            "kind": "token",
            "from": {
              "self": true
            }
          },
          "note": "token identifier: rank-zero scalar",
          "role": "activation.token_index",
          "description": "Token identifier: a rank-zero integer per token."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "token",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The normalized embedding."
        }
      }
    },
    "parameters": {
      "weight": {
        "role": "embedding.table",
        "sharing": {
          "kind": "shareable",
          "roles": [
            "embedding.table"
          ],
          "note": "sharing allowed between embedding table and output head: same axis identities in the same order, no view required"
        },
        "shape": {
          "axes": [
            {
              "name": "vocabulary",
              "axis": "model.vocabulary",
              "nature": "structural",
              "extent": {
                "argument": "vocabulary"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Token table."
      },
      "position": {
        "role": "embedding.position",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "position",
              "axis": "sequence.position",
              "nature": "structural",
              "extent": {
                "argument": "positions"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Position table."
      },
      "token_type": {
        "role": "embedding.token_type",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "type",
              "axis": "token.type",
              "nature": "structural",
              "extent": {
                "argument": "token_types"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Segment-type table."
      },
      "norm": {
        "role": "norm.scale",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Scale of the LayerNorm."
      },
      "norm_bias": {
        "role": "norm.bias",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Bias of the LayerNorm."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "tokens"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "model.vocabulary"
        },
        "semantics": "preserved",
        "communication": "all_gather",
        "description": "Vocabulary parallelism: each shard holds a slice of the token table; the looked-up rows are gathered."
      }
    ],
    "note": "Word + position + segment type sum, followed by a LayerNorm."
  }
}
