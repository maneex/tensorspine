    "  list corrections  required",
    "  list sparsity  required",
    "  section state  required",
    "    number append_bytes_per_cached_position  required  shown as bytes",
    "    number bounded_bytes  required  shown as bytes",
    "    number fixed_bytes  required  shown as bytes",
