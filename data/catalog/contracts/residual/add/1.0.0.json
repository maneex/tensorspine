{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "residual.add",
  "definition": {
    "version": "1.0.0",
    "summary": "Residual addition: `a + b`.",
    "description": "An occurrence with two input ports, not an annotation on a step: the value graph says which output feeds `a` and which feeds `b`, and the values live at a cut follow from it.",
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of both operands."
      }
    },
    "ports": {
      "inputs": {
        "a": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "First operand, usually the residual stream."
        },
        "b": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Second operand, usually a branch output."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The sum."
        }
      }
    },
    "parameters": {},
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "a",
        "b"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [
      {
        "target": {
          "any_axis": true
        },
        "communication": "none",
        "description": "Elementwise: any axis, no communication."
      }
    ],
    "note": "Residual addition. §3.5: this is not a step annotation, it is an occurrence with two input ports."
  }
}
