{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "identity",
  "definition": {
    "version": "1.0.0",
    "summary": "Fan-out point: passes its input to its output unchanged.",
    "description": "A public input is a single endpoint and a value edge has one destination; when a value must feed several ports — the first norm and the residual `a` of a pre-norm trunk — it goes through an identity occurrence whose output is bound to each of them. No parameter, no computation.",
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width passed through."
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The value to fan out."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The same value."
        }
      }
    },
    "parameters": {},
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [],
    "note": "Fan-out point with no computation. A public input is a single endpoint; the input of a pre-norm trunk feeds two ports (the norm and the 'a' of the first residual)."
  }
}
