{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "norm.rms",
  "definition": {
    "version": "1.0.0",
    "summary": "Root-mean-square normalization with a learned scale.",
    "description": "Divides the input by its root mean square over `width` (plus `eps`) and multiplies by `weight`. No bias and no centering: that is what makes it non-interchangeable with `norm.layer`.",
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/1910.07467",
        "title": "Root Mean Square Layer Normalization (Zhang & Sennrich, 2019)",
        "kind": "paper"
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width normalized over."
      },
      "eps": {
        "type": {
          "kind": "real"
        },
        "required": true,
        "structural": false,
        "description": "Added to the mean square before the root; changes no tensor."
      },
      "zero_centered": {
        "type": {
          "kind": "boolean"
        },
        "required": false,
        "structural": false,
        "default": {
          "literal": false
        },
        "description": "The scale is stored as an offset from one: the output is the normalized input times `1 + weight`, as Qwen 3.5 stores it. Changes no tensor."
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The value to normalize."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The normalized value."
        }
      }
    },
    "parameters": {
      "weight": {
        "role": "norm.scale",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Per-channel scale."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "model.width"
        },
        "communication": "all_reduce",
        "description": "The sum of squares over the feature axis is reduced."
      }
    ],
    "note": "RMSNorm. eps is not structural: it changes no slot, port or state."
  }
}
