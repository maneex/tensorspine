#!/usr/bin/env python3
"""tensorspine — one entry point for the model documents of this repository.

    tensorspine --validate [PATH ...]    grammar, then meaning. The gate.
    tensorspine --lint     [PATH ...]    hygiene. Advisory, never blocks.
    tensorspine --d1       [PATH ...]    emit D1, the expanded graph (§7).
    tensorspine --derive   [PATH ...]    emit the derived document, D1 to D6 (§7).
    tensorspine --view     [PATH ...]    render a self-contained HTML page.
    tensorspine --document catalog [PATH ...]
                                      render the catalog as one Markdown file.

With no PATH, every model of the default model directory is taken. Every
location defaults to the layout of the repository and can be overridden.

`--validate` and `--lint` answer different questions, and the difference is not
one of severity. A validation error is a refusal with its cause, as §8.1
requires; a lint finding is an opinion a reasonable author may decline. So
`--validate` exits 1 on the first document that fails, and `--lint` always
exits 0.

Exit status: 0 nothing wrong, 1 at least one document failed, 2 bad usage.
"""
import argparse
import glob
import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, HERE)

DEFAULT_MODELS = os.path.join(ROOT, 'data', 'models')
DEFAULT_CATALOG = os.path.join(ROOT, 'data', 'catalog')
DEFAULT_SCHEMAS = os.path.join(ROOT, 'schemas')


def collect(paths, default_dir):
    """The documents to work on: what was named, or every model of the default
    directory. A directory expands to the JSON files it holds."""
    if not paths:
        paths = [default_dir]
    documents = []
    for p in paths:
        if os.path.isdir(p):
            documents.extend(sorted(glob.glob(os.path.join(p, '*.json'))))
        else:
            documents.append(p)
    return documents


def build_parser():
    parser = argparse.ArgumentParser(
        prog='tensorspine',
        description='Validate, lint, expand and visualize tensorspine/2.0 model documents.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="A validation error is a refusal; a lint finding is advice. "
               "That is why --lint always exits 0.")

    command = parser.add_mutually_exclusive_group(required=True)
    command.add_argument('--validate', action='store_true',
                         help='check the document against its schema, then against the '
                              'catalog: resolution, arguments, shapes, domains, bindings, '
                              'acyclicity. Exits 1 on any refusal.')
    command.add_argument('--lint', action='store_true',
                         help='report what is legal but worth knowing: a declared catalog '
                              'base nothing resolves from, contracts and axes the corpus '
                              'never calls. Always exits 0.')
    command.add_argument('--d1', action='store_true',
                         help='emit D1, the expanded graph: loops unrolled, indices '
                              'evaluated, template contracts expanded in place.')
    command.add_argument('--derive', action='store_true',
                         help='emit the derived document: D1 with D2–D6 — values and cut '
                              'payloads, parameter tensors, states, logical costs, legal cuts and '
                              'partitions — as one JSON per model, validated against the derived '
                              'schema. --d1 emits the graph alone in the same form.')
    command.add_argument('--view', action='store_true',
                         help='render a self-contained HTML page: the model document and, '
                              'beside it, the derived document --derive would write for it, '
                              'built into a temporary file first. A model whose products '
                              'cannot be derived still gets a page. Needs Graphviz on PATH.')
    command.add_argument('--document', metavar='WHAT', choices=['catalog'],
                         help='render WHAT as one Markdown document. `catalog`: every '
                              'contract, axis and precision role of the bases, with the '
                              'documentation fields they carry; templates are resolved where '
                              'each base declares them. Writes to -o, or to stdout.')

    parser.add_argument('paths', nargs='*', metavar='PATH',
                        help=f'model documents, or a directory of them '
                             f'(default: {os.path.relpath(DEFAULT_MODELS, ROOT)}/)')
    parser.add_argument('-o', '--output', metavar='PATH',
                        help='where to write, for --d1, --derive, --view and --document. A '
                             'directory takes one file per model (catalog.md for --document); '
                             'omitted, --d1, --derive and --view land beside their model and '
                             '--document writes to stdout.')
    command.add_argument('--capabilities', metavar='MANIFEST',
                         help='read a backend\'s capabilities manifest (backends/CAPABILITIES.md): validate it '
                              'against its schema and the catalog, then say for each document whether the '
                              'backend can run it for the inputs --inputs names (default: those required for '
                              'the generative output); --coverage adds what the catalog and the corpus still need.')
    parser.add_argument('--inputs', metavar='NAMES', help='for --capabilities: the public inputs delivered, comma-separated')
    parser.add_argument('--coverage', action='store_true', help='for --capabilities: the coverage report over the catalog and the corpus')
    parser.add_argument('--catalog', metavar='DIR', action='append',
                        help='a catalog base, repeatable, overriding the bases a document '
                             'declares in its `catalog` field (which are resolved relative to '
                             'the document). --lint and --document without it use the first '
                             f'document\'s bases, or {os.path.relpath(DEFAULT_CATALOG, ROOT)}/.')
    parser.add_argument('--schemas', metavar='DIR', default=DEFAULT_SCHEMAS,
                        help=f'directory holding the JSON Schemas; they are indexed by '
                             f'their own $id (default: {os.path.relpath(DEFAULT_SCHEMAS, ROOT)}/)')
    parser.add_argument('--site-nav', metavar='FILE',
                        help='for --view: an HTML fragment holding the navigation of the '
                             'documentation site, put at the top of every page rendered. '
                             'Without it a page carries the name alone, so that one rendered '
                             'outside the site has no link leading nowhere (tools/site.sh '
                             'passes docs/style/nav.html, resolved for the output directory).')
    parser.add_argument('--checkpoint', metavar='DIR',
                        help='with --validate: check every located tensor of the document against '
                             'the safetensors headers of this checkpoint (V17) — existence, shape, '
                             'dtype. No weight is read; unnamed physical tensors are listed as advice.')
    parser.add_argument('--assign', metavar='JSON',
                        help='values for the external quantities of a template, '
                             'as a JSON object. A template denotes one graph per admissible '
                             'assignment (§4.6), so it needs one to be read alone.')
    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)

    documents = collect(args.paths, DEFAULT_MODELS)
    if not documents:
        print("no model document to work on", file=sys.stderr)
        return 2
    missing = [p for p in documents if not os.path.isfile(p)]
    if missing:
        for p in missing:
            print(f"no such file: {p}", file=sys.stderr)
        return 2

    bases = args.catalog        # None: each document resolves from its own `catalog` field
    assignment = {}
    if args.assign:
        try:
            assignment = json.loads(args.assign)
        except json.JSONDecodeError as e:
            print(f"--assign is not valid JSON: {e}", file=sys.stderr)
            return 2
        if not isinstance(assignment, dict):
            print("--assign expects a JSON object", file=sys.stderr)
            return 2

    try:
        return dispatch(args, documents, bases, assignment, parser)
    except catalog_error() as e:
        print(f"catalog refused: {e}", file=sys.stderr)
        return 1


def catalog_error():
    import catalog
    return catalog.CatalogError


def dispatch(args, documents, bases, assignment, parser):
    if args.validate:
        import validate
        print(f"validate  {len(documents)} document(s)")
        failed, skipped = validate.run(documents, args.schemas, bases, assignment)
        print(f"  {len(documents) - failed - skipped}/{len(documents)} pass"
              + (f", {skipped} need an assignment" if skipped else "")
              + (f", {failed} fail" if failed else ""))
        if args.checkpoint and not failed:
            import artifact
            print(f"checkpoint  {args.checkpoint}")
            failed += artifact.run(documents, bases, args.checkpoint, assignment)
        return 1 if failed else 0

    if args.capabilities:
        import capabilities
        corpus = sorted(glob.glob(os.path.join(DEFAULT_MODELS, '*.json'))) if args.coverage else []
        return capabilities.run(args.capabilities, documents, bases, args.inputs.split(',') if args.inputs else None,
                                args.coverage, corpus)

    if args.lint:
        import lint
        print(f"lint  {len(documents)} document(s)")
        return lint.run(documents, bases, relative_to=ROOT)

    if args.d1:
        import d1
        print(f"d1  {len(documents)} document(s)")
        failed, skipped = d1.run(documents, bases, args.output, assignment,
                                 schema_dir=args.schemas)
        return 1 if failed else 0

    if args.derive:
        import derive
        print(f"derive  {len(documents)} document(s)")
        failed, skipped = derive.run(documents, bases, args.output, assignment,
                                     schema_dir=args.schemas)
        return 1 if failed else 0

    if args.view:
        import view
        print(f"view  {len(documents)} document(s)")
        failed = view.run(documents, args.output, site_nav=args.site_nav,
                          bases=bases, assignment=assignment, schema_dir=args.schemas)
        return 1 if failed else 0

    if args.document:
        import document
        # The page goes to stdout when no -o is given; the status line must not.
        print(f"document  {args.document}",
              file=sys.stderr if args.output is None else sys.stdout)
        return document.run(documents, bases or [DEFAULT_CATALOG], args.schemas, args.output,
                            relative_to=ROOT)

    parser.print_help()
    return 2


if __name__ == '__main__':
    sys.exit(main())
