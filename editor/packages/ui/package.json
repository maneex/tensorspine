{
  "name": "@tensorspine/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The interface: shell, activities, canvas, the generic schema walker and its forms, sheets, panels, the primitive editor. No platform import.",
  "exports": {
    ".": "./src/index.ts",
    "./layout": "./src/layout/elk.ts",
    "./shell": "./src/shell/index.ts",
    "./documents": "./src/documents/index.ts",
    "./canvas": "./src/canvas/index.ts",
    "./expanded": "./src/expanded/index.ts",
    "./source": "./src/source/index.ts",
    "./explorer": "./src/explorer/index.ts",
    "./style.css": "./src/shell/shell.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tensorspine/lang": "workspace:*",
    "@tensorspine/store": "workspace:*",
    "elkjs": "^0.12.0",
    "monaco-editor": "0.56.0",
    "react": "18.3.1",
    "zustand": "5.0.2"
  }
}
