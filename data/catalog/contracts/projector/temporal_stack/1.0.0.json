{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "projector.temporal_stack",
  "definition": {
    "version": "1.0.0",
    "summary": "Audio-language projector: stacks `merge_count` consecutive frames, then two bias-free projections.",
    "description": "`merge_count` consecutive encoder outputs are concatenated into one `source_width * merge_count` vector, projected to `width` by `input` and again by `output`. The output is in the token domain.",
    "tags": [
      "multimodal"
    ],
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2507.13264",
        "title": "Voxtral (Mistral AI, 2025)",
        "kind": "paper",
        "description": "The audio-language adapter: frames downsampled by concatenation, then an MLP."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the language model."
      },
      "source_width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the audio encoder."
      },
      "merge_count": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Frames stacked into one token."
      },
      "source": {
        "type": {
          "kind": "port_reference"
        },
        "required": true,
        "structural": true,
        "description": "The port whose position domain the stacking consumes."
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "source_width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Encoder outputs, in the audio width."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "token",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "One token per stacked group."
        }
      }
    },
    "parameters": {
      "input": {
        "role": "projector.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "packed_audio",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "source_width"
                  },
                  {
                    "argument": "merge_count"
                  }
                ]
              }
            }
          ]
        },
        "description": "Projection from the stacked frames to `width`."
      },
      "output": {
        "role": "projector.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Second projection, `width → width`."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [],
    "domain_transforms": [
      {
        "from_port": "input",
        "to_port": "output",
        "relation": "merge",
        "factor": {
          "argument": "merge_count"
        },
        "description": "`merge_count` frames become one token."
      }
    ],
    "note": "Temporal stacking followed by two bias-free projections."
  }
}
