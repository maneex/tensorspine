{
  "schema": "armature-catalog-unit/2.0",
  "kind": "contract",
  "name": "ffn.dense",
  "definition": {
    "version": "1.1.0",
    "summary": "Dense feed-forward network: an up projection, a non-linearity, then a down projection.",
    "description": "`in` projects to `inner`, the activation is applied, `out` projects back to `width`. The same conditioning and sparsity options as `ffn.gated`, without the gate half.",
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/1706.03762",
        "title": "Attention Is All You Need (Vaswani et al., 2017)",
        "kind": "paper",
        "description": "The position-wise feed-forward network."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Feature width of `input` and `output`."
      },
      "inner": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Inner width."
      },
      "activation": {
        "type": {
          "kind": "enum",
          "values": [
            "silu",
            "gelu",
            "gelu_tanh",
            "relu2"
          ]
        },
        "required": true,
        "affects_template": false,
        "note": "selects the non-linearity; changes no template",
        "description": "Non-linearity applied after the up projection.",
        "value_descriptions": {
          "silu": "SiLU.",
          "gelu": "Exact GELU.",
          "gelu_tanh": "Tanh-approximated GELU.",
          "relu2": "Squared ReLU."
        }
      },
      "in_bias": {
        "type": {
          "kind": "boolean"
        },
        "required": false,
        "affects_template": true,
        "default": {
          "literal": false
        },
        "description": "Learned bias on the up projection."
      },
      "out_bias": {
        "type": {
          "kind": "boolean"
        },
        "required": false,
        "affects_template": true,
        "default": {
          "literal": false
        },
        "description": "Learned bias on the down projection."
      },
      "condition_dim": {
        "type": {
          "kind": "cardinality"
        },
        "required": false,
        "affects_template": true,
        "note": "rank of the temporal conditioning projector",
        "description": "Rank of the conditioning projector; present, `condition_in` and `condition_out` exist."
      },
      "condition": {
        "type": {
          "kind": "opaque"
        },
        "required": false,
        "affects_template": false,
        "description": "How the conditioning signal is applied. Opaque."
      },
      "activation_sparsity": {
        "type": {
          "kind": "opaque"
        },
        "required": false,
        "affects_template": false,
        "note": "structural fraction of activations zeroed after selection",
        "description": "Fraction of activations zeroed after selection. Opaque."
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Residual-stream activation."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "FFN output."
        }
      }
    },
    "parameters": {
      "in": {
        "role": "ffn.up_projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "inner",
              "axis": "ffn.inner",
              "nature": "feature",
              "extent": {
                "argument": "inner"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Up projection."
      },
      "out": {
        "role": "ffn.down_projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "inner",
              "axis": "ffn.inner",
              "nature": "feature",
              "extent": {
                "argument": "inner"
              }
            }
          ]
        },
        "description": "Down projection."
      },
      "in_bias": {
        "role": "ffn.projection_bias",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "inner",
              "axis": "ffn.inner",
              "nature": "feature",
              "extent": {
                "argument": "inner"
              }
            }
          ]
        },
        "present_when": {
          "compare": {
            "operator": "equal",
            "left": {
              "argument": "in_bias"
            },
            "right": {
              "literal": true
            }
          }
        },
        "description": "Bias of the up projection."
      },
      "out_bias": {
        "role": "ffn.projection_bias",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "present_when": {
          "compare": {
            "operator": "equal",
            "left": {
              "argument": "out_bias"
            },
            "right": {
              "literal": true
            }
          }
        },
        "description": "Bias of the down projection."
      },
      "condition_in": {
        "role": "conditioning.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "condition",
              "axis": "conditioning.feature",
              "nature": "feature",
              "extent": {
                "argument": "condition_dim"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "present_when": {
          "present": "condition_dim"
        },
        "description": "Projection of the input into the conditioning rank."
      },
      "condition_out": {
        "role": "conditioning.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "condition",
              "axis": "conditioning.feature",
              "nature": "feature",
              "extent": {
                "argument": "condition_dim"
              }
            }
          ]
        },
        "present_when": {
          "present": "condition_dim"
        },
        "description": "Projection of the conditioning rank back to `width`."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "logical_cost": {
      "operations": {
        "expression": {
          "op": "multiply",
          "args": [
            {
              "literal": 4
            },
            {
              "argument": "width"
            },
            {
              "argument": "inner"
            }
          ]
        },
        "status": "exact",
        "per": "token",
        "description": "Two `width × inner` projections per token."
      }
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "ffn.inner"
        },
        "semantics": "preserved",
        "communication": "all_reduce",
        "description": "Tensor parallelism across the inner width; the down projection needs an all-reduce."
      }
    ],
    "note": "Dense FFN: one up projection and one down projection."
  }
}
