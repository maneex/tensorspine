    "  map states  required  keys #/$defs/qualified_name",
  ],
  "boolean_condition": [
    "section boolean_condition",
    "  toggle boolean  required",
  ],
  "boolean_type": [
    "section boolean_type",
    "  constant kind  required  = boolean",
  ],
  "cardinality_type": [
    "section cardinality_type",
    "  constant kind  required  = cardinality",
  ],
  "comparison_condition": [
    "section comparison_condition",
    "  section compare  required",
    "    select operator  required  [equal|not_equal|less|less_or_equal|greater|greater_or_equal]",
    "    expression left  required  {literal:scalar | quantity:text→quantity | index:text→index | expression:expression}",
    "    expression right  required  {literal:scalar | quantity:text→quantity | index:text→index | expression:expression}",
  ],
  "composition_definition": [
    "section composition_definition",
    "  map indices  required  keys #/$defs/identifier  members>=1",
