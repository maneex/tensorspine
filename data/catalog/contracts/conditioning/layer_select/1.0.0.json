{
  "schema": "armature-catalog-unit/2.0",
  "kind": "contract",
  "name": "conditioning.layer_select",
  "definition": {
    "version": "1.0.0",
    "summary": "Selects, from the per-layer auxiliary vectors, the slice that belongs to one layer.",
    "description": "The input carries one `width` vector per layer (`layers × width`); `layer` names which one this occurrence forwards. No parameter, no computation beyond the selection.",
    "arguments": {
      "layers": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Number of layers in the input."
      },
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Width of one slice."
      },
      "layer": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": false,
        "description": "Which layer's slice to forward: an index into the `layers` slices of the input."
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "layer",
                "axis": "model.layer",
                "nature": "structural",
                "extent": {
                  "argument": "layers"
                }
              },
              {
                "name": "condition",
                "axis": "conditioning.feature",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The vectors of every layer."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "condition",
                "axis": "conditioning.feature",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The selected layer's vector."
        }
      }
    },
    "parameters": {},
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [],
    "note": "Explicit selection of the conditioning slice associated with a layer."
  }
}
