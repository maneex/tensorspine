{
  "schema": "armature-catalog-unit/2.0",
  "kind": "contract",
  "name": "mix.collapse",
  "definition": {
    "version": "1.0.0",
    "summary": "Hyper-connections head: reduces the `multiplicity` residual streams to one before the final norm.",
    "description": "`fn` projects the flattened streams to `multiplicity` read coefficients, `base` holds their static part and `scale` one coefficient; the streams are combined accordingly into a single `width` vector.",
    "tags": [
      "parallel-residual"
    ],
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2409.19606",
        "title": "Hyper-Connections (Zhu et al., 2024)",
        "kind": "paper",
        "description": "Learned mixing of several residual streams in place of the residual addition."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Feature width of one stream."
      },
      "multiplicity": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Number of parallel residual streams."
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The residual streams."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The single stream."
        }
      }
    },
    "parameters": {
      "fn": {
        "role": "residual.hyper_connection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "out",
              "axis": "residual.stream",
              "nature": "structural",
              "extent": {
                "argument": "multiplicity"
              }
            },
            {
              "name": "streams",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "multiplicity"
                  },
                  {
                    "argument": "width"
                  }
                ]
              }
            }
          ]
        },
        "description": "Input-dependent read coefficients."
      },
      "base": {
        "role": "residual.hyper_connection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "stream",
              "axis": "residual.stream",
              "nature": "structural",
              "extent": {
                "argument": "multiplicity"
              }
            }
          ]
        },
        "description": "Static read coefficients."
      },
      "scale": {
        "role": "residual.hyper_connection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "coefficient",
              "axis": "residual.stream",
              "nature": "structural",
              "extent": {
                "literal": 1
              }
            }
          ]
        },
        "description": "Learned scaling coefficient."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [],
    "note": "mHC head: final reduction of the residual streams before the output norm."
  }
}
