{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorspine.dev/schema/generators/capabilities.json",
  "title": "Capabilities of a generator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generator",
    "compute_dtypes",
    "parameter_dtypes",
    "state_laws",
    "access",
    "sharing",
    "partitions",
    "domains",
    "sessions_per_invocation",
    "locations",
    "contracts"
  ],
  "properties": {
    "schema": {
      "const": "tensorspine-capabilities/1"
    },
    "role": {
      "enum": [
        "witness",
        "conformer"
      ],
      "description": "`witness` for the one generator whose kernels are the authority for what each contract version computes (Specification §4.1, O1.3): its entries carry a `witness` block. Absent, `conformer`: an implementation checked against the witness's fixtures, which carries no witness block."
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "generator",
        "generated"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "generated": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        }
      }
    },
    "compute_dtypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dtype"
      }
    },
    "parameter_dtypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dtype"
      }
    },
    "state_laws": {
      "type": "array",
      "items": {
        "enum": [
          "append",
          "window",
          "fixed"
        ]
      }
    },
    "access": {
      "type": "array",
      "items": {
        "enum": [
          "logical_position",
          "ring",
          "aggregate",
          "selected"
        ]
      }
    },
    "sharing": {
      "type": "array",
      "items": {
        "enum": [
          "by_position",
          "by_source",
          "within_span",
          "at_fork_point"
        ]
      }
    },
    "partitions": {
      "type": "array",
      "items": {
        "enum": [
          "none",
          "all_reduce",
          "all_gather",
          "all_to_all"
        ]
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kinds",
        "transforms",
        "fragmented"
      ],
      "properties": {
        "kinds": {
          "type": "array",
          "items": {
            "enum": [
              "sequence",
              "token",
              "position",
              "patch"
            ]
          }
        },
        "transforms": {
          "type": "array",
          "items": {
            "enum": [
              "merge",
              "align",
              "insert"
            ]
          }
        },
        "fragmented": {
          "type": "boolean"
        }
      }
    },
    "sessions_per_invocation": {
      "type": "integer",
      "minimum": 1
    },
    "locations": {
      "type": "array",
      "items": {
        "enum": [
          "tensor",
          "stack",
          "concat",
          "slice"
        ]
      }
    },
    "contracts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/contract"
      }
    }
  },
  "$defs": {
    "dtype": {
      "enum": [
        "bool",
        "u4",
        "i4",
        "u8",
        "i8",
        "i16",
        "i32",
        "i64",
        "f8e4m3",
        "f8e5m2",
        "fp4",
        "f16",
        "bf16",
        "f32",
        "f64"
      ]
    },
    "rule": {
      "oneOf": [
        {
          "enum": [
            "any",
            "absent"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "values"
          ],
          "properties": {
            "absent": {
              "type": "boolean"
            },
            "values": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fields"
          ],
          "properties": {
            "absent": {
              "type": "boolean"
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/rule"
              }
            }
          }
        }
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arguments",
        "states"
      ],
      "properties": {
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/rule"
          }
        },
        "excluding": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "states": {
          "type": "array",
          "items": {
            "enum": [
              "append",
              "window",
              "fixed"
            ]
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transforms": {
          "type": "array",
          "items": {
            "enum": [
              "merge",
              "align",
              "insert"
            ]
          },
          "description": "the domain transforms of the contract the kernel realises"
        },
        "witness": {
          "$ref": "#/$defs/witness"
        }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel",
        "tolerance",
        "fixtures"
      ],
      "properties": {
        "kernel": {
          "type": "string",
          "description": "The kernel that is the authority for this contract version: its file, relative to the manifest's directory."
        },
        "tolerance": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "f32",
              "bf16",
              "f16"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "atol",
              "rtol"
            ],
            "properties": {
              "atol": {
                "type": "number",
                "minimum": 0
              },
              "rtol": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "description": "Per compute dtype of a conformer: the tolerance its outputs and states must meet against the witness's unit fixtures, `|a − b| ≤ atol + rtol·|b|`; a dtype without an entry is not covered."
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*@[0-9]+\\.[0-9]+\\.[0-9]+/[a-z0-9][a-z0-9-]*$"
          },
          "description": "The unit fixtures the kernel produced (docs/TENSORSPINE-FIXTURE.md), by id, each at `fixtures/contracts/<id>.safetensors` beside the manifest."
        }
      },
      "description": "The binding of a contract version to its witness (Specification §4.1): the language declares the role, the witness generator's manifest names the kernel, its tolerances and its fixtures, and the reader checks that each exists. Derived from the kernels' own tables, never written by hand."
    }
  },
  "description": "A manifest per generator: what it can evaluate, in the language's vocabulary — so that a runtime infers whether it can run a document, and a maintainer reads what is not covered yet. Generated from the generator's code. Physical parameters and the targeted backend are opaque and not described here."
}
