{
  "schema": "tensorspine-primitive-library-unit/2.0",
  "kind": "primitive",
  "name": "residual.laurel",
  "definition": {
    "version": "1.0.0",
    "summary": "LAuReL branch: a low-rank projection of the input, normalized, to be added to the residual.",
    "description": "`left` projects `width` to `rank`, `right` projects back to `width`, `norm` (RMS, `eps`) normalizes that term, and the input is added: `output = input + norm(right(left(input)))` — a learned, low-rank augmentation of the residual connection.",
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2411.07501",
        "title": "LAuReL: Learned Augmented Residual Layer (Menghani et al., 2024)",
        "kind": "paper"
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of `input` and `output`.",
        "domain": {
          "kind": "interval",
          "lower": {
            "value": {
              "literal": 1
            },
            "inclusive": true
          }
        }
      },
      "rank": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Rank of the low-rank pair.",
        "domain": {
          "kind": "interval",
          "lower": {
            "value": {
              "literal": 1
            },
            "inclusive": true
          }
        }
      },
      "eps": {
        "type": {
          "kind": "real"
        },
        "required": true,
        "structural": false,
        "description": "Epsilon of the normalization; changes no tensor.",
        "domain": {
          "kind": "interval",
          "lower": {
            "value": {
              "literal": 0
            },
            "inclusive": false
          }
        }
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Residual-stream activation."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The branch to add to the residual."
        }
      }
    },
    "parameters": {
      "left": {
        "role": "residual.low_rank",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "rank",
              "axis": "residual.rank",
              "nature": "feature",
              "extent": {
                "argument": "rank"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Down projection, `width → rank`."
      },
      "right": {
        "role": "residual.low_rank",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "rank",
              "axis": "residual.rank",
              "nature": "feature",
              "extent": {
                "argument": "rank"
              }
            }
          ]
        },
        "description": "Up projection, `rank → width`."
      },
      "norm": {
        "role": "norm.scale",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Scale of the output normalization."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "invariants": [
      {
        "holds": {
          "compare": {
            "operator": "less_or_equal",
            "left": {
              "argument": "rank"
            },
            "right": {
              "argument": "width"
            }
          }
        },
        "description": "the rank does not exceed the width"
      }
    ],
    "partition_options": [
      {
        "target": {
          "argument_axis": "residual.rank"
        },
        "communication": "all_reduce",
        "description": "The low-rank bottleneck is split; the up projection's partial outputs are reduced."
      }
    ],
    "note": "Low-rank LAuReL residual branch followed by an RMSNorm."
  }
}
