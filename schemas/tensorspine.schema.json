    "physical_name": {
      "type": "array",
      "minItems": 1,
      "description": "The name of a physical tensor in the artifact, as tagged data: literal strings, `{\"index\": i}` (a composition index of the rule, printed in decimal) and `{\"coordinate\": a}` (the coordinate of a `stack`).",
