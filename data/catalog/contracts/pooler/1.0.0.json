{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "pooler",
  "definition": {
    "version": "1.0.0",
    "summary": "Pooling head: projects hidden states to `project_to` features, optionally normalized and reduced.",
    "description": "Produces an embedding rather than logits: `weight` projects to `project_to`, `normalize` applies L2 normalization, `reduce` collapses the sequence to one vector (`mean`, `cls`) or keeps one vector per token (`none`, as ColBERT does). The granularity of the result is declared by the public output that reads it, not by the primitive.",
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2112.01488",
        "title": "ColBERTv2 (Santhanam et al., 2021)",
        "kind": "paper",
        "description": "Per-token embeddings, projected and L2-normalized."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the hidden state."
      },
      "project_to": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the embedding."
      },
      "normalize": {
        "type": {
          "kind": "enum",
          "values": [
            "l2",
            "none"
          ]
        },
        "required": true,
        "structural": true,
        "description": "Normalization of each output vector.",
        "value_descriptions": {
          "l2": "Unit L2 norm.",
          "none": "No normalization."
        }
      },
      "reduce": {
        "type": {
          "kind": "enum",
          "values": [
            "mean",
            "cls",
            "none"
          ]
        },
        "required": false,
        "structural": true,
        "default": {
          "literal": "none"
        },
        "description": "Reduction over the sequence.",
        "value_descriptions": {
          "mean": "Mean over the positions.",
          "cls": "The first position.",
          "none": "One vector per position."
        }
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Hidden state."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.feature",
                "nature": "feature",
                "extent": {
                  "argument": "project_to"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "note": "granularity is carried by the public OUTPUT, not by the primitive",
          "role": "activation.embedding",
          "description": "The embedding."
        }
      }
    },
    "parameters": {
      "weight": {
        "role": "pooler.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.feature",
              "nature": "feature",
              "extent": {
                "argument": "project_to"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "The projection, `project_to × width`."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": []
  }
}
