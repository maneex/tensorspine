    "  text title  length>=1 length<=120 matches ^[^\\r\\n]*\\S$",
    "  text description  length>=1 matches \\S",
    "  select kind  [paper|reference_implementation|specification|discussion|other]",
  ],
  "external_docs": [
    "list external_docs  items>=1",
  ],
  "license": [
    "section license",
    "  text name  required  length>=1",
    "  text identifier  length>=1",
    "  text url  length>=1 matches ^\\S+$",
  ],
  "primitive_reference": [
    "section primitive_reference",
    "  text name  required  matches ^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
    "  text version  required  matches ^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
  ],
  "summary": [
    "text summary  length>=1 length<=120 matches ^[^\\r\\n]*\\S$",
  ],
  "tag_definition": [
    "section tag_definition",
    "  text name  required  matches ^[a-z][a-z0-9_-]*$",
    "  text summary  required  length>=1 length<=120 matches ^[^\\r\\n]*\\S$",
    "  text description  length>=1 matches \\S",
    "  list external_docs  items>=1",
  ],
  "tag_definitions": [
    "list tag_definitions  items>=1",
  ],
  "tag_name": [
    "text tag_name  matches ^[a-z][a-z0-9_-]*$",
  ],
  "tags": [
    "list tags  items>=1 unique",
  ],
  "title": [
    "text title  length>=1 length<=120 matches ^[^\\r\\n]*\\S$",
  ],
  "unit_documentation": [
    "section unit_documentation",
    "  text summary  length>=1 length<=120 matches ^[^\\r\\n]*\\S$",
    "  text description  length>=1 matches \\S",
    "  list external_docs  items>=1",
    "  list tags  items>=1 unique",
    "  section deprecated",
    "    text reason  required  length>=1 matches \\S",
    "    section superseded_by",
    "      text name  required  matches ^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
