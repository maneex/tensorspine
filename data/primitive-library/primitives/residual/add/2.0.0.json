{
  "schema": "tensorspine-primitive-library-unit/3.0",
  "kind": "primitive",
  "name": "residual.add",
  "definition": {
    "version": "2.0.0",
    "summary": "Residual addition: `a + b`.",
    "description": "An instance with two input ports, not an annotation on a step: the value graph says which output feeds `a` and which feeds `b`, and the values live at a graph split follow from it.",
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of both operands.",
        "domain": {
          "kind": "interval",
          "lower": {
            "value": {
              "literal": 1
            },
            "inclusive": true
          }
        }
      }
    },
    "ports": {
      "inputs": {
        "a": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "First operand, usually the residual stream."
        },
        "b": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Second operand, usually a branch output."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The sum."
        }
      }
    },
    "parameters": {},
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "a",
        "b"
      ],
      "writes": [
        "output"
      ]
    },
    "partition_options": [
      {
        "target": {
          "any_axis": true
        },
        "communication": "none",
        "description": "Elementwise: any axis, no communication."
      }
    ],
    "note": "Residual addition. §3.5: this is not a step annotation, it is an instance with two input ports."
  }
}
