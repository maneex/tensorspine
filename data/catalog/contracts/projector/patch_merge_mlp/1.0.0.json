{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "projector.patch_merge_mlp",
  "definition": {
    "version": "1.0.0",
    "summary": "Vision-language projector: merges `merge_count` patches, normalizes, then a two-layer MLP with biases.",
    "description": "The `merge_count` embedded patches of a group are normalized (`norm`, `norm_bias`), concatenated into one `source_width * merge_count` vector, passed through `hidden` (same width) with a non-linearity and projected to `width` by `output`. The output is in the token domain: the merge is the domain transform from patches to tokens.",
    "tags": [
      "multimodal"
    ],
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2409.12191",
        "title": "Qwen2-VL (Wang et al., 2024)",
        "kind": "paper",
        "description": "The patch merger: adjacent patches concatenated and projected by an MLP."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the language model."
      },
      "source_width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the vision tower."
      },
      "merge_count": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Patches merged into one token."
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "source_width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Embedded patches, in the vision width."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "token",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "One token per merged group."
        }
      }
    },
    "parameters": {
      "norm": {
        "role": "norm.scale",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "source",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "source_width"
              }
            }
          ]
        },
        "description": "Scale of the pre-merge normalization."
      },
      "norm_bias": {
        "role": "norm.bias",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "source",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "source_width"
              }
            }
          ]
        },
        "description": "Bias of the pre-merge normalization."
      },
      "hidden": {
        "role": "projector.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "merged_out",
              "axis": "vision.merged_patch",
              "nature": "feature",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "source_width"
                  },
                  {
                    "argument": "merge_count"
                  }
                ]
              }
            },
            {
              "name": "merged_in",
              "axis": "vision.merged_patch",
              "nature": "feature",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "source_width"
                  },
                  {
                    "argument": "merge_count"
                  }
                ]
              }
            }
          ]
        },
        "description": "First projection over the concatenated patches."
      },
      "hidden_bias": {
        "role": "projector.bias",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "merged",
              "axis": "vision.merged_patch",
              "nature": "feature",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "source_width"
                  },
                  {
                    "argument": "merge_count"
                  }
                ]
              }
            }
          ]
        },
        "description": "Bias of the first projection."
      },
      "output": {
        "role": "projector.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "merged",
              "axis": "vision.merged_patch",
              "nature": "feature",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "source_width"
                  },
                  {
                    "argument": "merge_count"
                  }
                ]
              }
            }
          ]
        },
        "description": "Projection to the language width."
      },
      "output_bias": {
        "role": "projector.bias",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Bias of the output projection."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "ffn.inner"
        },
        "communication": "all_reduce",
        "description": "Column-parallel up, row-parallel down over the inner axis; the down projection's partial outputs are reduced."
      }
    ],
    "domain_transforms": [
      {
        "from_port": "input",
        "to_port": "output",
        "relation": "merge",
        "factor": {
          "argument": "merge_count"
        },
        "description": "`merge_count` patches become one token."
      }
    ],
    "note": "Patch concatenation, LayerNorm and a projection MLP with biases."
  }
}
