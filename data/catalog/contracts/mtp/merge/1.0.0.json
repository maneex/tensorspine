{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "mtp.merge",
  "definition": {
    "version": "1.0.0",
    "summary": "Multi-token prediction merge: the current hidden state and the next token's embedding, projected to `width`.",
    "description": "The one computation a multi-token-prediction head adds to the vocabulary. The head itself is a second trunk of the model: the shared embedding table (tied) supplies the embedding of the next token, `merge` combines it with the main trunk's final hidden state, ordinary block primitives follow, and the shared output head (tied) produces the logits of the token one step further ahead. Follows the published DeepSeek-V3 design with one prediction depth; deeper heads chain further trunks.",
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of both inputs and of the output."
      }
    },
    "ports": {
      "inputs": {
        "hidden": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The main trunk's final hidden state of the current token."
        },
        "next_embedding": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The embedding of the next token."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The merged state, input of the prediction block."
        }
      }
    },
    "parameters": {
      "weight": {
        "role": "mtp.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "merged",
              "axis": "model.width",
              "nature": "projection",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "literal": 2
                  },
                  {
                    "argument": "width"
                  }
                ]
              }
            }
          ]
        },
        "description": "The `width × 2·width` merge projection."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "hidden",
        "next_embedding"
      ],
      "writes": [
        "output"
      ],
      "across_positions": {
        "when": {
          "boolean": true
        },
        "description": "`next_embedding` is the embedding of the element after `hidden`'s: a read one position ahead"
      }
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "model.width"
        },
        "communication": "all_gather",
        "description": "Column-parallel over the output features; the shards are gathered for the block that follows."
      }
    ],
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2412.19437",
        "title": "DeepSeek-V3 Technical Report (DeepSeek-AI, 2024)",
        "kind": "paper",
        "description": "Multi-token prediction modules, §2.2."
      }
    ]
  }
}
