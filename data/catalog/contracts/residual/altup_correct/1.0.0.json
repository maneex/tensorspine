{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "residual.altup_correct",
  "definition": {
    "version": "1.0.0",
    "summary": "AltUp correction: updates every stream from the computed active stream and rescales it.",
    "description": "Given the predicted streams and the layer's output on the active one, `correction` (`streams × streams`) propagates the difference to every stream; `correct_scale` rescales the active output.",
    "tags": [
      "parallel-residual"
    ],
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2301.13310",
        "title": "Alternating Updates for Efficient Transformers (Baykal et al., 2023)",
        "kind": "paper",
        "description": "Parallel residual streams with one active stream per layer."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of one stream."
      },
      "streams": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Number of parallel residual streams."
      }
    },
    "ports": {
      "inputs": {
        "predictions": {
          "shape": {
            "axes": [
              {
                "name": "stream",
                "axis": "residual.stream",
                "nature": "structural",
                "extent": {
                  "argument": "streams"
                }
              },
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Predicted streams, from `residual.altup_predict`."
        },
        "activated": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The layer's output on the active stream."
        }
      },
      "outputs": {
        "streams": {
          "shape": {
            "axes": [
              {
                "name": "stream",
                "axis": "residual.stream",
                "nature": "structural",
                "extent": {
                  "argument": "streams"
                }
              },
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Corrected streams."
        },
        "active": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Rescaled active stream."
        }
      }
    },
    "parameters": {
      "correction": {
        "role": "residual.stream",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "out",
              "axis": "residual.stream",
              "nature": "structural",
              "extent": {
                "argument": "streams"
              }
            },
            {
              "name": "in",
              "axis": "residual.stream",
              "nature": "structural",
              "extent": {
                "argument": "streams"
              }
            }
          ]
        },
        "description": "Correction coefficients."
      },
      "correct_scale": {
        "role": "residual.stream",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Per-channel scale of the active stream."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "predictions",
        "activated"
      ],
      "writes": [
        "streams",
        "active"
      ]
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "model.width"
        },
        "semantics": "preserved",
        "communication": "none",
        "description": "Streams are corrected per feature; features are independent."
      }
    ],
    "note": "AltUp correction of the stream set and scaling of the active stream."
  }
}
