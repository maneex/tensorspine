{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "ffn.gated",
  "definition": {
    "version": "1.0.0",
    "summary": "Gated feed-forward network: gate and up projections, a multiplicative activation, then a down projection.",
    "description": "`in` fuses the gate and up projections into `2*inner` rows; the activation is applied to the gate half and multiplied by the up half, then `out` projects back to `width`. `activation` selects the non-linearity and changes no tensor. `condition_dim` adds a rank-`condition_dim` conditioning path (`condition_in`, `condition_out`) whose use is selected by `condition`; `activation_sparsity` zeroes a structural fraction of the activations.",
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2002.05202",
        "title": "GLU Variants Improve Transformer (Shazeer, 2020)",
        "kind": "paper",
        "description": "SwiGLU, GEGLU and the fused gate/up form."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of `input` and `output`."
      },
      "inner": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Inner width: the size of the gate and up outputs."
      },
      "activation": {
        "type": {
          "kind": "enum",
          "values": [
            "silu",
            "gelu",
            "gelu_tanh",
            "relu2"
          ]
        },
        "required": true,
        "structural": false,
        "note": "selects the non-linearity; not structural",
        "description": "Non-linearity applied to the gate half.",
        "value_descriptions": {
          "silu": "SiLU (SwiGLU).",
          "gelu": "Exact GELU (GEGLU).",
          "gelu_tanh": "Tanh-approximated GELU.",
          "relu2": "Squared ReLU."
        }
      },
      "in_bias": {
        "type": {
          "kind": "boolean"
        },
        "required": false,
        "structural": true,
        "default": {
          "literal": false
        },
        "description": "Learned bias on the fused gate/up projection."
      },
      "out_bias": {
        "type": {
          "kind": "boolean"
        },
        "required": false,
        "structural": true,
        "default": {
          "literal": false
        },
        "description": "Learned bias on the down projection."
      },
      "condition_dim": {
        "type": {
          "kind": "cardinality"
        },
        "required": false,
        "structural": true,
        "note": "rank of the temporal conditioning projector",
        "description": "Rank of the conditioning projector; present, `condition_in` and `condition_out` exist."
      },
      "condition": {
        "type": {
          "kind": "enum",
          "values": [
            "time"
          ]
        },
        "required": false,
        "structural": false,
        "description": "How the conditioning signal is applied.",
        "value_descriptions": {
          "time": "A temporal condition modulates the inner activation through the `condition_in`/`condition_out` projector."
        }
      },
      "activation_sparsity": {
        "type": {
          "kind": "real"
        },
        "required": false,
        "structural": false,
        "description": "Fraction of inner activations zeroed after selection, in [0, 1]; absent or 0, none.",
        "note": "structural fraction of activations zeroed after selection"
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Residual-stream activation."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "FFN output."
        }
      }
    },
    "parameters": {
      "in": {
        "role": "ffn.up_projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "gate_flat",
              "axis": "ffn.gate_flat",
              "nature": "projection",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "literal": 2
                  },
                  {
                    "argument": "inner"
                  }
                ]
              },
              "factors": [
                {
                  "name": "projection",
                  "axis": "ffn.projection",
                  "nature": "projection",
                  "extent": {
                    "literal": 2
                  }
                },
                {
                  "name": "inner",
                  "axis": "ffn.inner",
                  "nature": "feature",
                  "extent": {
                    "argument": "inner"
                  }
                }
              ]
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Fused gate and up projection."
      },
      "out": {
        "role": "ffn.down_projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "inner",
              "axis": "ffn.inner",
              "nature": "feature",
              "extent": {
                "argument": "inner"
              }
            }
          ]
        },
        "description": "Down projection."
      },
      "in_bias": {
        "role": "ffn.projection_bias",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "inner",
              "axis": "ffn.inner",
              "nature": "feature",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "literal": 2
                  },
                  {
                    "argument": "inner"
                  }
                ]
              }
            }
          ]
        },
        "present_when": {
          "compare": {
            "operator": "equal",
            "left": {
              "argument": "in_bias"
            },
            "right": {
              "literal": true
            }
          }
        },
        "description": "Bias of the fused projection, over both halves."
      },
      "out_bias": {
        "role": "ffn.projection_bias",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "present_when": {
          "compare": {
            "operator": "equal",
            "left": {
              "argument": "out_bias"
            },
            "right": {
              "literal": true
            }
          }
        },
        "description": "Bias of the down projection."
      },
      "condition_in": {
        "role": "conditioning.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "condition",
              "axis": "conditioning.feature",
              "nature": "feature",
              "extent": {
                "argument": "condition_dim"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "present_when": {
          "present": "condition_dim"
        },
        "description": "Projection of the input into the conditioning rank."
      },
      "condition_out": {
        "role": "conditioning.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "condition",
              "axis": "conditioning.feature",
              "nature": "feature",
              "extent": {
                "argument": "condition_dim"
              }
            }
          ]
        },
        "present_when": {
          "present": "condition_dim"
        },
        "description": "Projection of the conditioning rank back to `width`."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "logical_cost": {
      "operations": {
        "expression": {
          "op": "multiply",
          "args": [
            {
              "literal": 6
            },
            {
              "argument": "width"
            },
            {
              "argument": "inner"
            }
          ]
        },
        "status": "exact",
        "per": "token",
        "description": "Three `width × inner` projections per token."
      }
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "ffn.inner"
        },
        "semantics": "preserved",
        "communication": "all_reduce",
        "description": "Tensor parallelism across the inner width; the down projection needs an all-reduce."
      }
    ],
    "note": "Gated FFN: gate and up projections, multiplicative activation, then down projection."
  }
}
