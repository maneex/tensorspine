          "type": "object",
          "required": [
            "concat"
          ],
          "additionalProperties": false,
          "properties": {
            "concat": {
              "type": "object",
              "required": [
                "axis",
                "parts"
              ],
              "additionalProperties": false,
              "properties": {
                "axis": {
