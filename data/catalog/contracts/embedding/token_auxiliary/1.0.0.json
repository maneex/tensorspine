{
  "schema": "armature-catalog-unit/2.0",
  "kind": "contract",
  "name": "embedding.token_auxiliary",
  "definition": {
    "version": "1.0.0",
    "summary": "Token embedding that also emits a per-layer auxiliary vector for every layer of the stack.",
    "description": "Besides the usual `output`, the primitive computes `auxiliary`: for each of `layers` layers, a `per_layer_width` vector obtained by summing a per-layer table lookup of the token (`per_layer_embed`, over a vocabulary of `per_layer_vocabulary`) with a projection of the main embedding (`per_layer_model_projection`), normalized by `per_layer_projection_norm`. Each layer then selects its slice with `conditioning.layer_select` and applies it with `conditioning.multiplicative`.",
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Feature width of the main embedding."
      },
      "vocabulary": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Number of token identifiers."
      },
      "layers": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Number of layers receiving an auxiliary vector."
      },
      "per_layer_width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Width of one auxiliary vector."
      },
      "per_layer_vocabulary": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Size of the per-layer table's vocabulary."
      }
    },
    "ports": {
      "inputs": {
        "tokens": {
          "shape": {
            "axes": []
          },
          "domain": {
            "kind": "token",
            "from": {
              "self": true
            }
          },
          "note": "token identifier: rank-zero scalar",
          "role": "activation.token_index",
          "description": "Token identifier: a rank-zero integer per token."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "token",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The embedded token."
        },
        "auxiliary": {
          "shape": {
            "axes": [
              {
                "name": "layer",
                "axis": "model.layer",
                "nature": "structural",
                "extent": {
                  "argument": "layers"
                }
              },
              {
                "name": "condition",
                "axis": "conditioning.feature",
                "nature": "feature",
                "extent": {
                  "argument": "per_layer_width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "One `per_layer_width` vector per layer, for the whole stack."
        }
      }
    },
    "parameters": {
      "weight": {
        "role": "embedding.table",
        "sharing": {
          "kind": "shareable",
          "roles": [
            "embedding.table"
          ],
          "note": "sharing allowed between embedding table and output head: same axis identities in the same order, no view required"
        },
        "shape": {
          "axes": [
            {
              "name": "vocabulary",
              "axis": "model.vocabulary",
              "nature": "structural",
              "extent": {
                "argument": "vocabulary"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Token table."
      },
      "per_layer_embed": {
        "role": "embedding.table",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "vocabulary",
              "axis": "model.vocabulary",
              "nature": "structural",
              "extent": {
                "argument": "per_layer_vocabulary"
              }
            },
            {
              "name": "layer_features",
              "axis": "conditioning.feature",
              "nature": "feature",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "layers"
                  },
                  {
                    "argument": "per_layer_width"
                  }
                ]
              }
            }
          ]
        },
        "description": "Per-layer table: for each token of its vocabulary, `layers × per_layer_width` values."
      },
      "per_layer_model_projection": {
        "role": "conditioning.feature",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "layer_features",
              "axis": "conditioning.feature",
              "nature": "feature",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "layers"
                  },
                  {
                    "argument": "per_layer_width"
                  }
                ]
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Projection of the main embedding into the per-layer widths of every layer."
      },
      "per_layer_projection_norm": {
        "role": "norm.scale",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "per_layer",
              "axis": "conditioning.feature",
              "nature": "feature",
              "extent": {
                "argument": "per_layer_width"
              }
            }
          ]
        },
        "description": "Scale of the normalization applied to the projected per-layer vector."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "tokens"
      ],
      "writes": [
        "output",
        "auxiliary"
      ]
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "model.vocabulary"
        },
        "semantics": "preserved",
        "communication": "all_gather",
        "description": "Vocabulary parallelism: each shard holds a slice of the token table; the looked-up rows are gathered."
      }
    ],
    "note": "Token embedding enriched with a per-layer auxiliary table and projection."
  }
}
