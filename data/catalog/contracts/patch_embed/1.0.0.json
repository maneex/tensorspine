{
  "schema": "armature-catalog-unit/2.0",
  "kind": "contract",
  "name": "patch_embed",
  "definition": {
    "version": "1.0.0",
    "summary": "Patch embedding: projects each image or video patch to `width`.",
    "description": "A patch is `channels × temporal_patch × patch × patch` pixels; `weight` is their projection (a convolution whose stride is the patch), `bias` is optional, and `position` an optional learned table over `pos` patch positions. Output positions are in the `patch` domain.",
    "tags": [
      "multimodal"
    ],
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2010.11929",
        "title": "An Image is Worth 16x16 Words (Dosovitskiy et al., 2020)",
        "kind": "paper",
        "description": "Patch embedding of a vision transformer."
      },
      {
        "url": "https://arxiv.org/abs/2409.12191",
        "title": "Qwen2-VL (Wang et al., 2024)",
        "kind": "paper",
        "description": "Temporal patches: a 3D patch embedding shared by images and video."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Feature width of the vision tower."
      },
      "patch": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Spatial patch side, in pixels."
      },
      "channels": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "affects_template": true,
        "description": "Image channels."
      },
      "temporal_patch": {
        "type": {
          "kind": "cardinality"
        },
        "required": false,
        "affects_template": true,
        "default": {
          "literal": 1
        },
        "description": "Frames per patch, for video; one for images."
      },
      "pos": {
        "type": {
          "kind": "cardinality"
        },
        "required": false,
        "affects_template": true,
        "description": "Number of learned patch positions; absent when positions are rotary or computed."
      },
      "bias": {
        "type": {
          "kind": "boolean"
        },
        "required": false,
        "affects_template": true,
        "default": {
          "literal": false
        },
        "description": "The projection carries a learned bias."
      }
    },
    "ports": {
      "inputs": {
        "pixels": {
          "shape": {
            "axes": [
              {
                "name": "channels",
                "axis": "vision.channels",
                "nature": "feature",
                "extent": {
                  "argument": "channels"
                }
              },
              {
                "name": "temporal",
                "axis": "sequence.position",
                "nature": "structural",
                "extent": {
                  "argument": "temporal_patch"
                }
              },
              {
                "name": "patch_h",
                "axis": "vision.patch",
                "nature": "structural",
                "extent": {
                  "argument": "patch"
                }
              },
              {
                "name": "patch_w",
                "axis": "vision.patch",
                "nature": "structural",
                "extent": {
                  "argument": "patch"
                }
              }
            ]
          },
          "domain": {
            "kind": "patch",
            "from": {
              "self": true
            }
          },
          "role": "activation.pixels",
          "description": "One patch of pixels."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "patch",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The embedded patch."
        }
      }
    },
    "parameters": {
      "weight": {
        "role": "embedding.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "channels",
              "axis": "vision.channels",
              "nature": "feature",
              "extent": {
                "argument": "channels"
              }
            },
            {
              "name": "temporal",
              "axis": "sequence.position",
              "nature": "structural",
              "extent": {
                "argument": "temporal_patch"
              }
            },
            {
              "name": "patch_h",
              "axis": "vision.patch",
              "nature": "structural",
              "extent": {
                "argument": "patch"
              }
            },
            {
              "name": "patch_w",
              "axis": "vision.patch",
              "nature": "structural",
              "extent": {
                "argument": "patch"
              }
            }
          ]
        },
        "description": "Patch projection."
      },
      "bias": {
        "role": "embedding.bias",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "present_when": {
          "compare": {
            "operator": "equal",
            "left": {
              "argument": "bias"
            },
            "right": {
              "literal": true
            }
          }
        },
        "description": "Bias of the projection."
      },
      "position": {
        "role": "embedding.position",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "position",
              "axis": "sequence.position",
              "nature": "structural",
              "extent": {
                "argument": "pos"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "present_when": {
          "present": "pos"
        },
        "description": "Learned position table."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "pixels"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": []
  }
}
