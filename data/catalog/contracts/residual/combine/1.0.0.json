{
  "schema": "armature-catalog-unit/2.0",
  "kind": "contract",
  "name": "residual.combine",
  "definition": {
    "version": "1.0.0",
    "summary": "Weighted combination of two branches: `left*left_scale + right*right_scale`, times `output_scale`.",
    "description": "The scales change the computation, not a tensor. Used where a model averages two branches or scales a residual.",
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of both operands."
      },
      "left_scale": {
        "type": {
          "kind": "real"
        },
        "required": false,
        "structural": false,
        "default": {
          "literal": 1
        },
        "description": "Factor applied to `left`."
      },
      "right_scale": {
        "type": {
          "kind": "real"
        },
        "required": false,
        "structural": false,
        "default": {
          "literal": 1
        },
        "description": "Factor applied to `right`."
      },
      "output_scale": {
        "type": {
          "kind": "real"
        },
        "required": false,
        "structural": false,
        "default": {
          "literal": 1
        },
        "description": "Factor applied to the sum."
      }
    },
    "ports": {
      "inputs": {
        "left": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "First branch."
        },
        "right": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Second branch."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The weighted combination."
        }
      }
    },
    "parameters": {},
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "left",
        "right"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [],
    "note": "Combination of two branches with explicit scalar factors."
  }
}
