{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "residual.altup_correct",
  "definition": {
    "version": "1.0.0",
    "summary": "AltUp correction: updates every stream from the computed active stream and rescales it.",
    "description": "Given the predicted streams and the layer's output on the active one, `correction` (`streams × streams`) propagates the difference to every stream; `correct_scale` rescales the active output. Computation: the router of the layer's output, as in `altup_predict`, gives one coefficient per stream, plus one; the innovation `activated − predicted active` times each stream's coefficient is added to the predictions; `active` is the corrected active stream multiplied channel-wise by `correct_scale`, while `streams` keeps it unscaled. The coefficients come from the same router as `altup_predict`'s (`router` after `router_norm`, tied between the two occurrences of a layer): the layer's output is routed as the input was.",
    "tags": [
      "parallel-residual"
    ],
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2301.13310",
        "title": "Alternating Updates for Efficient Transformers (Baykal et al., 2023)",
        "kind": "paper",
        "description": "Parallel residual streams with one active stream per layer."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of one stream.",
        "domain": {
          "kind": "interval",
          "lower": {
            "value": {
              "literal": 1
            },
            "inclusive": true
          }
        }
      },
      "streams": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Number of parallel residual streams.",
        "domain": {
          "kind": "interval",
          "lower": {
            "value": {
              "literal": 2
            },
            "inclusive": true
          }
        }
      },
      "eps": {
        "type": {
          "kind": "real"
        },
        "required": true,
        "structural": false,
        "description": "Epsilon of the router's normalization (`router_norm`, `altup_predict`'s).",
        "domain": {
          "kind": "interval",
          "lower": {
            "value": {
              "literal": 0
            },
            "inclusive": false
          }
        }
      }
    },
    "ports": {
      "inputs": {
        "predictions": {
          "shape": {
            "axes": [
              {
                "name": "stream",
                "axis": "residual.stream",
                "nature": "structural",
                "extent": {
                  "argument": "streams"
                }
              },
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Predicted streams, from `residual.altup_predict`."
        },
        "activated": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The layer's output on the active stream."
        }
      },
      "outputs": {
        "streams": {
          "shape": {
            "axes": [
              {
                "name": "stream",
                "axis": "residual.stream",
                "nature": "structural",
                "extent": {
                  "argument": "streams"
                }
              },
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Corrected streams."
        },
        "active": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Rescaled active stream."
        }
      }
    },
    "parameters": {
      "router": {
        "role": "residual.stream",
        "sharing": {
          "kind": "shareable",
          "roles": [
            "residual.stream"
          ],
          "note": "one router per layer, read by altup_predict and altup_correct alike"
        },
        "shape": {
          "axes": [
            {
              "name": "altup",
              "axis": "residual.stream",
              "nature": "structural",
              "extent": {
                "argument": "streams"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Router projection producing the mixing coefficients — `altup_predict`'s, tied."
      },
      "router_norm": {
        "role": "norm.scale",
        "sharing": {
          "kind": "shareable",
          "roles": [
            "norm.scale"
          ],
          "note": "the router's normalization, shared with altup_correct"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Scale of the router's input normalization — `altup_predict`'s, tied."
      },
      "correction": {
        "role": "residual.stream",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "out",
              "axis": "residual.stream",
              "nature": "structural",
              "extent": {
                "argument": "streams"
              }
            },
            {
              "name": "in",
              "axis": "residual.stream",
              "nature": "structural",
              "extent": {
                "argument": "streams"
              }
            }
          ]
        },
        "description": "Correction coefficients."
      },
      "correct_scale": {
        "role": "residual.stream",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Per-channel scale of the active stream."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "predictions",
        "activated"
      ],
      "writes": [
        "streams",
        "active"
      ]
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "model.width"
        },
        "communication": "none",
        "description": "Streams are corrected per feature; features are independent."
      }
    ],
    "note": "AltUp correction of the stream set and scaling of the active stream."
  }
}
