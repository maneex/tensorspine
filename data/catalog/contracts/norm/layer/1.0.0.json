{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "norm.layer",
  "definition": {
    "version": "1.0.0",
    "summary": "Layer normalization with a learned scale and bias.",
    "description": "Centers and scales the input over `width` (variance plus `eps`), then applies `weight` and `bias`.",
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/1607.06450",
        "title": "Layer Normalization (Ba, Kiros & Hinton, 2016)",
        "kind": "paper"
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width normalized over."
      },
      "eps": {
        "type": {
          "kind": "real"
        },
        "required": true,
        "structural": false,
        "description": "Added to the variance before the root; changes no tensor."
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The value to normalize."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "The normalized value."
        }
      }
    },
    "parameters": {
      "weight": {
        "role": "norm.scale",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Per-channel scale."
      },
      "bias": {
        "role": "norm.bias",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Per-channel bias."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "model.width"
        },
        "semantics": "preserved",
        "communication": "all_reduce",
        "description": "Mean and variance over the feature axis: partial sums are reduced."
      }
    ],
    "note": "LayerNorm: carries a bias, unlike RMSNorm. That is what makes them non-interchangeable."
  }
}
