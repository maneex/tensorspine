{
  "schema": "armature-catalog-unit/2.0",
  "kind": "contract",
  "name": "attention.latent_compressed",
  "definition": {
    "version": "1.0.0",
    "summary": "Latent attention: low-rank query and output projections, one compressed latent KV, optional sparse index.",
    "description": "Keys and values are not stored per head: `kv` projects each position to one `head_dim` latent vector, normalized by `kv_norm`, and the heads attend to that latent directly — there is no per-head key or value tensor, and the cache holds `head_dim` values per position whatever `heads` is. Queries go through a rank-`q_rank` bottleneck (`q_a`, `q_a_norm`, `q_b`) and the output projection through `o_groups` groups of rank `o_rank` (`o_a`, `o_b`). Learned `sinks` give each head a logit that absorbs attention mass without reading a position.\n\n`compress` folds `compress.ratio` consecutive positions into one cached latent: the `kv` cache grows by one entry every `compress.ratio` positions (its stride), and the open group is kept in the `compressor` state — a ring of `compress.overlap * compress.ratio` positions — with its own position table (`compressor_ape`), key/value-and-gate projection (`compressor_kv_gate`) and normalization. `window` adds a `sliding` cache of the last `window.span` uncompressed latents. `index`, when present, adds a sparse selector: `index.heads` small heads of `index.head_dim` score every cached key (`index_q`, `index_weights`; keys kept in the `index` state and compressed the same way) and keep the `index.topk` best positions for the full attention.\n\n`rope` changes the computation, not a tensor or a state; it is a closed record, so an unnamed variant is refused. The main state ports are declared in every configuration: this primitive is stateful whatever `mask` says.",
    "tags": [
      "sequence-operator"
    ],
    "external_docs": [
      {
        "url": "https://arxiv.org/abs/2405.04434",
        "title": "DeepSeek-V2 (DeepSeek-AI, 2024)",
        "kind": "paper",
        "description": "Multi-head latent attention: one compressed latent per position instead of per-head keys and values."
      }
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of `input` and `output`."
      },
      "heads": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Number of query heads; every head reads the same latent."
      },
      "head_dim": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Dimension of one head and of the cached latent."
      },
      "q_rank": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Rank of the query bottleneck: `q_a` projects to it, `q_b` expands it to the heads."
      },
      "o_groups": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Number of groups of the low-rank output projection; each group covers `heads*head_dim / o_groups` channels."
      },
      "o_rank": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Rank of one output group."
      },
      "mask": {
        "type": {
          "kind": "enum",
          "values": [
            "causal",
            "chunked",
            "none"
          ]
        },
        "required": true,
        "structural": true,
        "description": "Which positions a query may attend to.",
        "value_descriptions": {
          "causal": "Each position attends to itself and to earlier positions.",
          "chunked": "Causal within fixed chunks.",
          "none": "Every position attends to every other."
        }
      },
      "window": {
        "type": {
          "kind": "record",
          "fields": {
            "span": {
              "type": {
                "kind": "physical",
                "unit": "tokens"
              },
              "required": true,
              "structural": true,
              "description": "Window span, in tokens."
            }
          }
        },
        "required": false,
        "structural": true,
        "description": "Sliding window of uncompressed latents: the `sliding` cache holds the last `window.span` positions."
      },
      "compress": {
        "type": {
          "kind": "record",
          "fields": {
            "ratio": {
              "type": {
                "kind": "cardinality"
              },
              "required": true,
              "structural": true,
              "description": "Positions folded into one cached latent; also the stride at which the caches grow."
            },
            "overlap": {
              "type": {
                "kind": "cardinality"
              },
              "required": true,
              "structural": true,
              "description": "Positions of context the compressor keeps around a group boundary."
            }
          }
        },
        "required": true,
        "structural": true,
        "description": "Temporal compression of the latent cache."
      },
      "index": {
        "type": {
          "kind": "record",
          "fields": {
            "head_dim": {
              "type": {
                "kind": "cardinality"
              },
              "required": true,
              "structural": true,
              "description": "Dimension of one index head and of a cached index key."
            },
            "heads": {
              "type": {
                "kind": "cardinality"
              },
              "required": true,
              "structural": true,
              "description": "Number of index heads."
            },
            "topk": {
              "type": {
                "kind": "cardinality"
              },
              "required": true,
              "structural": true,
              "description": "Positions the index keeps per query."
            },
            "overlap": {
              "type": {
                "kind": "cardinality"
              },
              "required": true,
              "structural": true,
              "description": "Overlap of the index compressor, as `compress.overlap` is for the main cache."
            }
          }
        },
        "required": false,
        "structural": true,
        "description": "Sparse index: a small attention that selects the positions the full attention reads."
      },
      "rope": {
        "type": {
          "kind": "record",
          "fields": {
            "theta": {
              "type": {
                "kind": "real"
              },
              "required": true,
              "structural": false,
              "description": "Base of the rotary frequencies of the decoupled key."
            },
            "compress_theta": {
              "type": {
                "kind": "real"
              },
              "required": false,
              "structural": false,
              "description": "Base of the rotary frequencies applied inside the compressor; absent, `theta`."
            },
            "partial_dims": {
              "type": {
                "kind": "cardinality"
              },
              "required": false,
              "structural": false,
              "description": "Channels of `head_dim` that carry the decoupled rotary key; absent, the whole head is rotated."
            },
            "scaling": {
              "type": {
                "kind": "record",
                "fields": {
                  "kind": {
                    "type": {
                      "kind": "enum",
                      "values": [
                        "yarn",
                        "llama3",
                        "linear"
                      ]
                    },
                    "required": true,
                    "structural": false,
                    "description": "Context-extension method applied to the rotary frequencies.",
                    "value_descriptions": {
                      "yarn": "YaRN: per-frequency interpolation between `beta_fast` and `beta_slow` wavelengths, with attention temperature.",
                      "llama3": "Llama 3 frequency scaling: wavelengths above `orig_ctx/low` are scaled by `factor`, below `orig_ctx/high` are kept, in between interpolated.",
                      "linear": "Position interpolation: every position is divided by `factor`."
                    }
                  },
                  "factor": {
                    "type": {
                      "kind": "real"
                    },
                    "required": true,
                    "structural": false,
                    "description": "Ratio between the served context and `orig_ctx`."
                  },
                  "orig_ctx": {
                    "type": {
                      "kind": "cardinality"
                    },
                    "required": true,
                    "structural": false,
                    "description": "Context length the frequencies were trained at."
                  },
                  "beta_fast": {
                    "type": {
                      "kind": "real"
                    },
                    "required": false,
                    "structural": false,
                    "present_when": {
                      "compare": {
                        "operator": "equal",
                        "left": {
                          "argument": "rope.scaling.kind"
                        },
                        "right": {
                          "literal": "yarn"
                        }
                      }
                    },
                    "description": "YaRN: number of rotations above which a frequency is left unscaled."
                  },
                  "beta_slow": {
                    "type": {
                      "kind": "real"
                    },
                    "required": false,
                    "structural": false,
                    "present_when": {
                      "compare": {
                        "operator": "equal",
                        "left": {
                          "argument": "rope.scaling.kind"
                        },
                        "right": {
                          "literal": "yarn"
                        }
                      }
                    },
                    "description": "YaRN: number of rotations below which a frequency is fully interpolated."
                  },
                  "low": {
                    "type": {
                      "kind": "real"
                    },
                    "required": false,
                    "structural": false,
                    "present_when": {
                      "compare": {
                        "operator": "equal",
                        "left": {
                          "argument": "rope.scaling.kind"
                        },
                        "right": {
                          "literal": "llama3"
                        }
                      }
                    },
                    "description": "Llama 3: low-frequency factor."
                  },
                  "high": {
                    "type": {
                      "kind": "real"
                    },
                    "required": false,
                    "structural": false,
                    "present_when": {
                      "compare": {
                        "operator": "equal",
                        "left": {
                          "argument": "rope.scaling.kind"
                        },
                        "right": {
                          "literal": "llama3"
                        }
                      }
                    },
                    "description": "Llama 3: high-frequency factor."
                  }
                }
              },
              "required": false,
              "structural": false,
              "description": "Context-extension scaling of the rotary frequencies; absent, the frequencies are used as trained."
            }
          }
        },
        "required": true,
        "structural": false,
        "description": "Rotary position encoding of the decoupled key: base, compressor base, rotated channels and context-extension scaling. Changes the computation, not a tensor or a state."
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Residual-stream activation: one vector of `width` per element of the indexing domain."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Attention output after the grouped low-rank output projection."
        }
      }
    },
    "parameters": {
      "q_a": {
        "role": "attention.query_down",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "q_rank",
              "axis": "attention.q_rank",
              "nature": "feature",
              "extent": {
                "argument": "q_rank"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Query down-projection to rank `q_rank`."
      },
      "kv": {
        "role": "attention.kv_projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "head_dim",
              "axis": "attention.head_dim",
              "nature": "feature",
              "extent": {
                "argument": "head_dim"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Latent projection: one `head_dim` vector per position, shared by every head — the cached quantity."
      },
      "q_a_norm": {
        "role": "norm.scale",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "q_rank",
              "axis": "attention.q_rank",
              "nature": "feature",
              "extent": {
                "argument": "q_rank"
              }
            }
          ]
        },
        "description": "Scale of the normalization applied to the query bottleneck."
      },
      "q_b": {
        "role": "attention.query_up",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "heads",
              "axis": "attention.heads",
              "nature": "projection",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "heads"
                  },
                  {
                    "argument": "head_dim"
                  }
                ]
              }
            },
            {
              "name": "q_rank",
              "axis": "attention.q_rank",
              "nature": "feature",
              "extent": {
                "argument": "q_rank"
              }
            }
          ]
        },
        "description": "Query up-projection from the bottleneck to the heads."
      },
      "kv_norm": {
        "role": "norm.scale",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "head_dim",
              "axis": "attention.head_dim",
              "nature": "feature",
              "extent": {
                "argument": "head_dim"
              }
            }
          ]
        },
        "description": "Scale of the normalization applied to the latent."
      },
      "o_a": {
        "role": "attention.output_down",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "group_rank",
              "axis": "attention.o_rank",
              "nature": "projection",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "o_groups"
                  },
                  {
                    "argument": "o_rank"
                  }
                ]
              }
            },
            {
              "name": "head_group",
              "axis": "attention.head_group",
              "nature": "feature",
              "extent": {
                "op": "floor_divide",
                "args": [
                  {
                    "op": "multiply",
                    "args": [
                      {
                        "argument": "heads"
                      },
                      {
                        "argument": "head_dim"
                      }
                    ]
                  },
                  {
                    "argument": "o_groups"
                  }
                ]
              }
            }
          ]
        },
        "description": "Output down-projection: `o_groups` groups, each from its `heads*head_dim / o_groups` channels to rank `o_rank`."
      },
      "o_b": {
        "role": "attention.output_up",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "group_rank",
              "axis": "attention.o_rank",
              "nature": "feature",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "o_groups"
                  },
                  {
                    "argument": "o_rank"
                  }
                ]
              }
            }
          ]
        },
        "description": "Output up-projection from the concatenated group ranks to `width`."
      },
      "sinks": {
        "role": "attention.sink",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "heads",
              "axis": "attention.heads",
              "nature": "structural",
              "extent": {
                "argument": "heads"
              }
            }
          ]
        },
        "description": "One learned logit per head that absorbs attention mass without reading a position."
      },
      "compressor_ape": {
        "role": "attention.compressor",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "ratio",
              "axis": "sequence.compression",
              "nature": "structural",
              "extent": {
                "argument": "compress.ratio"
              }
            },
            {
              "name": "overlap",
              "axis": "attention.head_dim",
              "nature": "feature",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "compress.overlap"
                  },
                  {
                    "argument": "head_dim"
                  }
                ]
              }
            }
          ]
        },
        "description": "Learned position table over the `compress.ratio` positions of a compression group."
      },
      "compressor_kv_gate": {
        "role": "attention.compressor",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "kv_gate",
              "axis": "attention.head_dim",
              "nature": "projection",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "literal": 2
                  },
                  {
                    "op": "multiply",
                    "args": [
                      {
                        "argument": "compress.overlap"
                      },
                      {
                        "argument": "head_dim"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Projection of the input to the compressor's key/value and gate, over the overlap window."
      },
      "compressor_norm": {
        "role": "norm.scale",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "head_dim",
              "axis": "attention.head_dim",
              "nature": "feature",
              "extent": {
                "argument": "head_dim"
              }
            }
          ]
        },
        "description": "Scale of the compressor's normalization."
      },
      "index_q": {
        "role": "attention.indexer",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "index_heads",
              "axis": "attention.index_heads",
              "nature": "projection",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "index.heads"
                  },
                  {
                    "argument": "index.head_dim"
                  }
                ]
              }
            },
            {
              "name": "q_rank",
              "axis": "attention.q_rank",
              "nature": "feature",
              "extent": {
                "argument": "q_rank"
              }
            }
          ]
        },
        "present_when": {
          "present": "index"
        },
        "description": "Query projection of the sparse index, from the query bottleneck."
      },
      "index_weights": {
        "role": "attention.indexer",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "index_heads",
              "axis": "attention.index_heads",
              "nature": "structural",
              "extent": {
                "argument": "index.heads"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "present_when": {
          "present": "index"
        },
        "description": "Per-index-head weights over the input."
      },
      "index_compressor_ape": {
        "role": "attention.compressor",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "ratio",
              "axis": "sequence.compression",
              "nature": "structural",
              "extent": {
                "argument": "compress.ratio"
              }
            },
            {
              "name": "overlap",
              "axis": "attention.index_dim",
              "nature": "feature",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "index.overlap"
                  },
                  {
                    "argument": "index.head_dim"
                  }
                ]
              }
            }
          ]
        },
        "present_when": {
          "present": "index"
        },
        "description": "Position table of the index compressor."
      },
      "index_compressor_kv_gate": {
        "role": "attention.compressor",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "kv_gate",
              "axis": "attention.index_dim",
              "nature": "projection",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "literal": 2
                  },
                  {
                    "argument": "index.overlap"
                  },
                  {
                    "argument": "index.head_dim"
                  }
                ]
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "present_when": {
          "present": "index"
        },
        "description": "Key/value-and-gate projection of the index compressor."
      },
      "index_compressor_norm": {
        "role": "norm.scale",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "index_dim",
              "axis": "attention.index_dim",
              "nature": "feature",
              "extent": {
                "argument": "index.head_dim"
              }
            }
          ]
        },
        "present_when": {
          "present": "index"
        },
        "description": "Scale of the index compressor's normalization."
      }
    },
    "constants": {},
    "state_ports": {
      "kv": {
        "present_when": {
          "boolean": true
        },
        "payload": {
          "latent": {
            "shape": {
              "axes": [
                {
                  "name": "latent",
                  "axis": "attention.head_dim",
                  "nature": "feature",
                  "extent": {
                    "argument": "head_dim"
                  }
                }
              ]
            },
            "role": "state.kv",
            "description": "The cached latent of one group."
          }
        },
        "key_axes": [
          "instance.session",
          "instance.branch"
        ],
        "operations": {
          "append": {
            "effect": "append",
            "description": "Add an entry at the end."
          },
          "read": {
            "effect": "read",
            "description": "Read the cached entries for a query."
          },
          "evict": {
            "effect": "evict",
            "description": "Drop entries no longer needed."
          }
        },
        "rules": [
          {
            "when": {
              "boolean": true
            },
            "law": "append",
            "access": "logical_position",
            "sharing": "by_position",
            "indexed_by": {
              "self": true
            },
            "stride": {
              "argument": "compress.ratio"
            },
            "description": "Grows by one latent every `compress.ratio` positions."
          }
        ],
        "description": "Compressed latent cache: one `head_dim` vector per group of `compress.ratio` positions."
      },
      "sliding": {
        "present_when": {
          "boolean": true
        },
        "payload": {
          "latent": {
            "shape": {
              "axes": [
                {
                  "name": "latent",
                  "axis": "attention.head_dim",
                  "nature": "feature",
                  "extent": {
                    "argument": "head_dim"
                  }
                }
              ]
            },
            "role": "state.kv",
            "description": "One uncompressed latent."
          }
        },
        "key_axes": [
          "instance.session",
          "instance.branch"
        ],
        "operations": {
          "append": {
            "effect": "append",
            "description": "Add an entry at the end."
          },
