{
  "schema": "tensorspine-catalog-unit/2.0",
  "kind": "contract",
  "name": "projector.patch_merge_bottleneck",
  "definition": {
    "version": "1.0.0",
    "summary": "Vision-language projector: normalizes, merges patches by a mixing matrix, then a two-projection bottleneck.",
    "description": "Patches are normalized (`norm`), `merge_count` of them combined by the learned `merger` into one `source_width` vector, projected to `width` by `linear_in` and refined by `linear_out` (`width → width`). Bias-free.",
    "tags": [
      "multimodal"
    ],
    "arguments": {
      "width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the language model."
      },
      "source_width": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Feature width of the vision tower."
      },
      "merge_count": {
        "type": {
          "kind": "cardinality"
        },
        "required": true,
        "structural": true,
        "description": "Patches merged into one token."
      }
    },
    "ports": {
      "inputs": {
        "input": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "source_width"
                }
              }
            ]
          },
          "domain": {
            "kind": "inherit",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "Embedded patches, in the vision width."
        }
      },
      "outputs": {
        "output": {
          "shape": {
            "axes": [
              {
                "name": "feature",
                "axis": "model.width",
                "nature": "feature",
                "extent": {
                  "argument": "width"
                }
              }
            ]
          },
          "domain": {
            "kind": "token",
            "from": {
              "self": true
            }
          },
          "role": "activation.hidden",
          "description": "One token per merged group."
        }
      }
    },
    "parameters": {
      "norm": {
        "role": "norm.scale",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "source",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "source_width"
              }
            }
          ]
        },
        "description": "Scale of the pre-merge normalization."
      },
      "merger": {
        "role": "projector.patch_merger",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "source",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "source_width"
              }
            },
            {
              "name": "merged",
              "axis": "vision.merged_patch",
              "nature": "projection",
              "extent": {
                "op": "multiply",
                "args": [
                  {
                    "argument": "source_width"
                  },
                  {
                    "argument": "merge_count"
                  }
                ]
              }
            }
          ]
        },
        "description": "Mixing matrix from `merge_count` concatenated patches to one `source_width` vector."
      },
      "linear_in": {
        "role": "projector.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "source",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "source_width"
              }
            }
          ]
        },
        "description": "Projection from the vision width to the language width."
      },
      "linear_out": {
        "role": "projector.projection",
        "sharing": {
          "kind": "exclusive"
        },
        "shape": {
          "axes": [
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            },
            {
              "name": "feature",
              "axis": "model.width",
              "nature": "feature",
              "extent": {
                "argument": "width"
              }
            }
          ]
        },
        "description": "Second projection, `width → width`."
      }
    },
    "constants": {},
    "state_ports": {},
    "effects": {
      "reads": [
        "input"
      ],
      "writes": [
        "output"
      ]
    },
    "partitions": [
      {
        "target": {
          "argument_axis": "model.width"
        },
        "communication": "all_reduce",
        "description": "Row-parallel over the merged input: partial outputs are reduced."
      }
    ],
    "domain_transforms": [
      {
        "from_port": "input",
        "to_port": "output",
        "relation": "merge",
        "factor": {
          "argument": "merge_count"
        },
        "description": "`merge_count` patches become one token."
      }
    ],
    "note": "Patch merging by a mixing matrix, then a two-projection bottleneck."
  }
}
